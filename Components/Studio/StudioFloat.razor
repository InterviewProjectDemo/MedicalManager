@namespace MedicalManager.Components.Studio
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Visible)
{
    <div @ref="_panel" class="studio-float place-@Place" style="@Style" role="dialog" aria-modal="false" aria-labelledby="@_titleId">
        <header class="studio-float-head" data-float-grip>
            <h2 id="@_titleId">@Title</h2>
            <div class="studio-float-actions">
                <button type="button" class="studio-float-fit" title="Full screen" aria-label="Full screen" @onpointerdown="FullScreen" @onpointerdown:stopPropagation="true" @onclick="FullScreen">
                    <span class="studio-float-glyph is-full" aria-hidden="true"></span>
                </button>
                <button type="button" class="studio-float-fit" title="Reduce size" aria-label="Reduce size" @onpointerdown="Reduce" @onpointerdown:stopPropagation="true" @onclick="Reduce">
                    <span class="studio-float-glyph is-reduce" aria-hidden="true"></span>
                </button>
                <button type="button" class="studio-float-close" aria-label="Close" @onpointerdown="Close" @onpointerdown:stopPropagation="true" @onclick="Close">&times;</button>
            </div>
        </header>
        <div class="studio-float-body">
            @ChildContent
        </div>
        <button type="button" class="studio-float-resize" data-float-resize aria-label="Resize"></button>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Place { get; set; } = "graph";
    [Parameter] public string? MemoryKey { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string _titleId = "studio-float-" + Guid.NewGuid().ToString("N");
    private readonly string _modulePath = "./Components/Studio/StudioFloat.razor.js";
    private ElementReference _panel;
    private IJSObjectReference? _module;
    private DotNetObjectReference<StudioFloat>? _self;
    private bool _hooked;
    private bool _placed;
    private bool _disposed;
    private double _left;
    private double _top;
    private double _width;
    private double _height;
    private int _z = 4100;

    private string? Style => _placed
        ? FormattableString.Invariant($"left:{_left:0.0}px;top:{_top:0.0}px;width:{_width:0.0}px;height:{_height:0.0}px;right:auto;bottom:auto;transform:none;z-index:{_z}")
        : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Visible || _disposed)
        {
            _hooked = false;
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", _modulePath);
            _self ??= DotNetObjectReference.Create(this);
            if (!_hooked)
            {
                await _module.InvokeVoidAsync("attach", _panel, _self, MemoryKey);
                _hooked = true;
            }
            await _module.InvokeVoidAsync("layer", _panel);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    [JSInvokable]
    public void Remember(double left, double top, double width, double height, int z)
    {
        _placed = true;
        _left = left;
        _top = top;
        _width = width;
        _height = height;
        _z = z;
        _ = InvokeAsync(StateHasChanged);
    }

    private long _chromeTick;

    private bool BeginChrome()
    {
        var now = Environment.TickCount64;
        if (now - _chromeTick < 450)
            return false;
        _chromeTick = now;
        return true;
    }

    private Task Close()
    {
        if (!BeginChrome())
            return Task.CompletedTask;
        return VisibleChanged.InvokeAsync(false);
    }

    private Task FullScreen()
    {
        if (!BeginChrome())
            return Task.CompletedTask;
        return FrameAsync("full");
    }

    private Task Reduce()
    {
        if (!BeginChrome())
            return Task.CompletedTask;
        return FrameAsync("reduce");
    }

    private async Task FrameAsync(string mode)
    {
        if (_disposed)
            return;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", _modulePath);
            var box = await _module.InvokeAsync<FrameBox>("frame", _panel, mode, MemoryKey);
            if (_disposed)
                return;
            Remember(box.Left, box.Top, box.Width, box.Height, box.Z);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private sealed class FrameBox
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
        public int Z { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _self?.Dispose();
        if (_module is null)
            return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
