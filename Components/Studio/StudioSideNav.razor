@namespace MedicalManager.Components.Studio

<div class="studio-nav">
    @if (Guest)
    {
        <NavLink class="studio-nav-link" href="Account/Login" @onclick="OnNavigate">
            @Mark("login", "Log in")
        </NavLink>
        <NavLink class="studio-nav-link" href="Account/Register" @onclick="OnNavigate">
            @Mark("register", "Register")
        </NavLink>
        <NavLink class="studio-nav-link" href="Account/Register?account=doctor" @onclick="OnNavigate">
            @Mark("doctorreg", "I'm a doctor")
        </NavLink>
        <button type="button" class="studio-nav-link @(AccessibilityOpen ? "active" : null)" aria-pressed="@(AccessibilityOpen ? "true" : "false")" @onclick="OpenAccessibility">
            @Mark("accessibility", "Accessibility")
        </button>
    }
    else
    {
        <AuthorizeView Roles="@AppRoles.Doctor" Context="doctorNav">
            <Authorized>
                <NavLink class="studio-nav-link" href="@Href("")" Match="NavLinkMatch.All" @onclick="OnNavigate">
                    @Mark("doctor-home", "Dashboard")
                </NavLink>
                <NavLink class="studio-nav-link" href="@Href("profile")" @onclick="OnNavigate">
                    @Mark("doctor-profile", "Profile")
                </NavLink>
                <NavLink class="studio-nav-link" href="patients" @onclick="OnNavigate">
                    @Mark("patient", "Patients")
                </NavLink>
                <button type="button" class="studio-nav-link" @onclick="OpenPrescription">
                    @Mark("doctor-rx", "Prescription")
                </button>
                <NavLink class="studio-nav-link" href="visit-notes" @onclick="OnNavigate">
                    @Mark("doctor-notes", "Notes")
                </NavLink>
                <NavLink class="studio-nav-link" href="messages" @onclick="OnNavigate">
                    @Mark("doctor-message", "Message")
                </NavLink>
                <NavLink class="studio-nav-link" href="set-appointment" @onclick="OnNavigate">
                    @Mark("doctor-appt", "Set Appointment")
                </NavLink>
                <NavLink class="studio-nav-link" href="calendar" @onclick="OnNavigate">
                    @Mark("doctor-appt", "Calendar")
                </NavLink>
                <NavLink class="studio-nav-link" href="video-visit" @onclick="OnNavigate">
                    @Mark("doctor-video", "Video Visit")
                </NavLink>
                <NavLink class="studio-nav-link" href="after-visit" @onclick="OnNavigate">
                    @Mark("doctor-summary", "After-visit summary")
                </NavLink>
                <NavLink class="studio-nav-link" href="referral" @onclick="OnNavigate">
                    @Mark("doctor-referral", "Referral")
                </NavLink>
                <button type="button" class="studio-nav-link @(CustomControlsOpen ? "active" : null)" aria-pressed="@(CustomControlsOpen ? "true" : "false")" title="Custom Controls" @onclick="OpenCustomControls">
                    @Mark("controls", "Controls")
                </button>
                <NavLink class="studio-nav-link" href="Account/Manage" title="@AccountName" @onclick="OnNavigate">
                    @Mark("doctor-account", "Account")
                </NavLink>
                <form class="studio-nav-form" action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@CurrentUrl" />
                    <button type="submit" class="studio-nav-link">
                        @Mark("doctor-logout", "Log out")
                    </button>
                </form>
            </Authorized>
            <NotAuthorized>
                <button type="button" class="studio-nav-link" @onclick="OnEmergency">
                    @Mark("emergency", "Emergency")
                </button>
                <button type="button" class="studio-nav-link" @onclick="OnVoice">
                    @Mark("voice", "Say Call")
                </button>
                <button type="button" class="studio-nav-link @(AccessibilityOpen ? "active" : null)" aria-pressed="@(AccessibilityOpen ? "true" : "false")" @onclick="OpenAccessibility">
                    @Mark("accessibility", "Accessibility")
                </button>
                <button type="button" class="studio-nav-link @(CustomControlsOpen ? "active" : null)" aria-pressed="@(CustomControlsOpen ? "true" : "false")" title="Custom Controls" @onclick="OpenCustomControls">
                    @Mark("controls", "Controls")
                </button>
                <NavLink class="studio-nav-link" href="@Href("dashboard-studio")" @onclick="OnNavigate">
                    @Mark("layout", "Layout")
                </NavLink>
                <NavLink class="studio-nav-link" href="@Href("profile")" @onclick="OnNavigate">
                    @Mark("profile", "Profile")
                </NavLink>
                <NavLink class="studio-nav-link" href="@Href("resource")" @onclick="OnNavigate">
                    @Mark("resource", "Resource")
                </NavLink>
                <NavLink class="studio-nav-link" href="access-requests" @onclick="OnNavigate">
                    @Mark("access", "Access")
                </NavLink>
                <NavLink class="studio-nav-link" href="@Href("calendar")" @onclick="OnNavigate">
                    @Mark("appt", "Calendar")
                </NavLink>
                <NavLink class="studio-nav-link" href="@Href("medication-schedule")" title="Daily medication schedule" @onclick="OnNavigate">
                    @Mark("schedule", "Schedule")
                </NavLink>
                <NavLink class="studio-nav-link" href="@Href("medications")" title="Medication list" @onclick="OnNavigate">
                    @Mark("meds", "Med list")
                </NavLink>
                <NavLink class="studio-nav-link" href="Account/Manage" title="@AccountName" @onclick="OnNavigate">
                    @Mark("account", "Account")
                </NavLink>
                <form class="studio-nav-form" action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@CurrentUrl" />
                    <button type="submit" class="studio-nav-link">
                        @Mark("logout", "Log out")
                    </button>
                </form>
            </NotAuthorized>
        </AuthorizeView>
    }
</div>

@code {
    [Parameter] public bool Guest { get; set; }
    [Parameter] public string? PatientUserId { get; set; }
    [Parameter] public string? CurrentUrl { get; set; }
    [Parameter] public string? AccountName { get; set; }
    [Parameter] public string? DoctorPhotoUrl { get; set; }
    [Parameter] public string? PatientPhotoUrl { get; set; }
    [Parameter] public EventCallback OnEmergency { get; set; }
    [Parameter] public EventCallback OnVoice { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }
    [Parameter] public EventCallback OnPrescription { get; set; }
    [Parameter] public EventCallback OnAccessibility { get; set; }
    [Parameter] public bool AccessibilityOpen { get; set; }
    [Parameter] public EventCallback OnCustomControls { get; set; }
    [Parameter] public bool CustomControlsOpen { get; set; }

    private async Task OpenPrescription()
    {
        await OnNavigate.InvokeAsync();
        await OnPrescription.InvokeAsync();
    }

    private async Task OpenAccessibility()
    {
        await OnNavigate.InvokeAsync();
        await OnAccessibility.InvokeAsync();
    }

    private async Task OpenCustomControls()
    {
        await OnNavigate.InvokeAsync();
        await OnCustomControls.InvokeAsync();
    }

    private string Href(string path) => CareLinks.To(path, PatientUserId);

    private RenderFragment Mark(string scene, string label) => @<span class="studio-nav-mark">
        <span class="studio-nav-orb"><FeatureScene Scene="@scene" /></span>
        <span class="studio-nav-name">@label</span>
    </span>;

}
