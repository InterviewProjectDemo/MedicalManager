@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@Href("")">MedicalManager</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-dash" href="@Href("")" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-bp" href="@Href("blood-pressure")">
                        <span class="bi bi-heart-nav-menu" aria-hidden="true"></span> Blood pressure
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-sugar" href="@Href("sugar")">
                        <span class="bi bi-droplet-nav-menu" aria-hidden="true"></span> Sugar
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-labs" href="@Href("labs")">
                        <span class="bi bi-flask-nav-menu" aria-hidden="true"></span> Labs
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-meds" href="@Href("medications")">
                        <span class="bi bi-pill-nav-menu" aria-hidden="true"></span> Medications
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-medcheck" href="@Href("med-check")">
                        <span class="bi bi-search-heart-nav-menu" aria-hidden="true"></span> Med Check
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-appt" href="@Href("appointments")">
                        <span class="bi bi-calendar-nav-menu" aria-hidden="true"></span> Appointments
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-providers" href="@Href("doctors")">
                        <span class="bi bi-stethoscope-nav-menu" aria-hidden="true"></span> Doctors
                    </NavLink>
                </div>
                <AuthorizeView Roles="@AppRoles.Doctor" Context="doctor">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link nav-doctor" href="patients">
                            <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Patients
                        </NavLink>
                    </div>
                </AuthorizeView>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link nav-dash" href="Account/Login">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private string? selectedPatientId;

    protected override void OnInitialized()
    {
        UpdateFromUri();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateFromUri();
        StateHasChanged();
    }

    private void UpdateFromUri()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        selectedPatientId = null;
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue("patientUserId", out var value))
        {
            selectedPatientId = value.ToString();
        }
    }

    private string Href(string path) => CareLinks.To(path, selectedPatientId);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
