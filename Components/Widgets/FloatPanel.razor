@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_panel" class="float-panel @Class" style="@Style" role="dialog" aria-modal="false" aria-labelledby="@LabelledBy">
    <div @ref="_grip"
         class="float-grip"
         role="button"
         aria-label="Drag to move"
         title="Drag to move"
         @onpointerdown="BeginDrag"
         @onpointermove="Drag"
         @onpointerup="EndDrag"
         @onpointercancel="EndDrag">
        <span>Drag to move</span>
    </div>
    <div class="float-body">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? LabelledBy { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static int _nextZ = 1800;

    private readonly string _modulePath = "./Components/Widgets/FloatPanel.razor.js";
    private IJSObjectReference? _module;
    private ElementReference _panel;
    private ElementReference _grip;
    private bool _dragging;
    private bool _placed;
    private int _dragToken;
    private bool _disposed;
    private double _startX;
    private double _startY;
    private double _originLeft;
    private double _originTop;
    private double _left;
    private double _top;
    private double _viewWidth = 1280;
    private double _viewHeight = 800;
    private int _z = 1320;

    private string Style => _placed
        ? FormattableString.Invariant($"left:{_left:0.0}px;top:{_top:0.0}px;right:auto;bottom:auto;transform:none;z-index:{_z}")
        : $"z-index:{_z}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is not null || _disposed)
            return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", _modulePath);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private async Task BeginDrag(PointerEventArgs e)
    {
        if (e.Button != 0 || _module is null)
            return;

        var token = ++_dragToken;
        _z = ++_nextZ;
        FloatOrigin origin;
        try
        {
            origin = await _module.InvokeAsync<FloatOrigin>("begin", _panel, _grip, e.PointerId);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            return;
        }

        if (token != _dragToken)
            return;

        _startX = e.ClientX;
        _startY = e.ClientY;
        _originLeft = origin.Left;
        _originTop = origin.Top;
        _viewWidth = origin.ViewWidth;
        _viewHeight = origin.ViewHeight;
        _left = _originLeft;
        _top = _originTop;
        _placed = true;
        _dragging = true;
    }

    private void Drag(PointerEventArgs e)
    {
        if (!_dragging)
            return;

        _left = Math.Clamp(_originLeft + e.ClientX - _startX, 8, Math.Max(8, _viewWidth - 96));
        _top = Math.Clamp(_originTop + e.ClientY - _startY, 8, Math.Max(8, _viewHeight - 48));
    }

    private void EndDrag(PointerEventArgs _)
    {
        _dragToken++;
        _dragging = false;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null)
            return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed class FloatOrigin
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double ViewWidth { get; set; }
        public double ViewHeight { get; set; }
    }
}
