<section class="table-card visit-tool-card">
    <h2>@(ForDoctor ? "Visit tools" : "With your doctors")</h2>
    <p class="muted">
        @(ForDoctor
            ? "Notes, messages, video, and medical transcripts for the selected patient. Each one opens in a window you can move and resize."
            : "Notes, a separate message tab for each doctor, video invites, after-visit summaries, and medical transcripts your doctor shared. Each one opens in a window you can move and resize.")
    </p>
    <div class="visit-tool-row">
        <button type="button" class="visit-tool" aria-pressed="@_notesOpen" @onclick="() => _notesOpen = true">
            <span class="visit-tool-logo">
                @if (ForDoctor)
                {
                    <FeatureScene Scene="doctor-notes" />
                }
                else
                {
                    <span class="bi bi-notes-nav-menu" aria-hidden="true"></span>
                }
            </span>
            <span>Notes</span>
        </button>
        <button type="button" class="visit-tool" aria-pressed="@_messageOpen" @onclick="() => _messageOpen = true">
            <span class="visit-tool-logo">
                @if (ForDoctor)
                {
                    <FeatureScene Scene="doctor-message" />
                }
                else
                {
                    <span class="bi bi-message-nav-menu" aria-hidden="true"></span>
                }
            </span>
            <span>Message</span>
        </button>
        <button type="button" class="visit-tool" aria-pressed="@_videoOpen" @onclick="() => _videoOpen = true">
            <span class="visit-tool-logo">
                @if (ForDoctor)
                {
                    <FeatureScene Scene="doctor-video" />
                }
                else
                {
                    <span class="bi bi-video-nav-menu" aria-hidden="true"></span>
                }
            </span>
            <span>Video Visit</span>
        </button>
        <button type="button" class="visit-tool" aria-pressed="@_transcriptOpen" @onclick="() => _transcriptOpen = true">
            <span class="visit-tool-logo">
                <span class="bi bi-transcript-nav-menu" aria-hidden="true"></span>
            </span>
            <span>Medical Transcript</span>
        </button>
        @if (!ForDoctor)
        {
            <button type="button" class="visit-tool" aria-pressed="@(_summaryOpen ? "true" : "false")" @onclick="() => _summaryOpen = true">
                <span class="visit-tool-logo">
                    <FeatureScene Scene="summary" />
                </span>
                <span>After Visit Summary</span>
            </button>
        }
    </div>
</section>

@if (_notesOpen)
{
    <StudioFloat @bind-Visible="_notesOpen" Title="Notes" Place="notes">
        <VisitNotesPanel PatientUserId="@PatientUserId" />
    </StudioFloat>
}
@if (_messageOpen)
{
    <StudioFloat @bind-Visible="_messageOpen" Title="Message" Place="message">
        <VisitMessagePanel PatientUserId="@PatientUserId" PatientName="@PatientName" />
    </StudioFloat>
}
@if (_videoOpen)
{
    <StudioFloat @bind-Visible="_videoOpen" Title="Video Visit" Place="video">
        <VisitVideoPanel PatientUserId="@PatientUserId" PatientName="@PatientName" />
    </StudioFloat>
}
@if (_summaryOpen)
{
    <StudioFloat @bind-Visible="_summaryOpen" Title="After-visit summary" Place="summary">
        <AfterVisitSummaryView PatientUserId="@PatientUserId" />
    </StudioFloat>
}
@if (_transcriptOpen)
{
    <StudioFloat @bind-Visible="_transcriptOpen" Title="Medical transcript" Place="transcript" MemoryKey="transcript">
        <MedicalTranscriptView ForDoctor="@ForDoctor" PatientUserId="@PatientUserId" />
    </StudioFloat>
}

@code {
    [Parameter] public bool ForDoctor { get; set; }
    [Parameter] public string? PatientUserId { get; set; }
    [Parameter] public string? PatientName { get; set; }

    private bool _notesOpen;
    private bool _messageOpen;
    private bool _videoOpen;
    private bool _summaryOpen;
    private bool _transcriptOpen;
}
