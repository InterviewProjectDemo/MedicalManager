<div class="access-scope-row">
    <span class="access-scope-title">@Title</span>
    <div class="access-scope-actions">
        <label>
            <input type="checkbox" checked="@ViewChecked" @onchange="SetView" />
            View
        </label>
        <label>
            <input type="checkbox" checked="@UpdateChecked" @onchange="SetUpdate" />
            Update
        </label>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<bool> SelectedChanged { get; set; }
    [Parameter] public ChartAccessLevel Level { get; set; } = ChartAccessLevel.View;
    [Parameter] public EventCallback<ChartAccessLevel> LevelChanged { get; set; }

    private bool ViewChecked => Selected && Level != ChartAccessLevel.None;

    private bool UpdateChecked => Selected && Level == ChartAccessLevel.Update;

    private async Task SetView(ChangeEventArgs e)
    {
        var on = e.Value is bool value && value;
        if (!on)
        {
            Selected = false;
            Level = ChartAccessLevel.None;
            await SelectedChanged.InvokeAsync(false);
            await LevelChanged.InvokeAsync(ChartAccessLevel.None);
            return;
        }

        Selected = true;
        if (Level != ChartAccessLevel.Update)
            Level = ChartAccessLevel.View;
        await SelectedChanged.InvokeAsync(true);
        await LevelChanged.InvokeAsync(Level);
    }

    private async Task SetUpdate(ChangeEventArgs e)
    {
        var on = e.Value is bool value && value;
        if (on)
        {
            Selected = true;
            Level = ChartAccessLevel.Update;
            await SelectedChanged.InvokeAsync(true);
            await LevelChanged.InvokeAsync(ChartAccessLevel.Update);
            return;
        }

        if (ViewChecked)
        {
            Level = ChartAccessLevel.View;
            await LevelChanged.InvokeAsync(Level);
            return;
        }

        Selected = false;
        Level = ChartAccessLevel.None;
        await SelectedChanged.InvokeAsync(false);
        await LevelChanged.InvokeAsync(ChartAccessLevel.None);
    }
}
