@using System.Security.Claims
@using MedicalManager.Data.Notifications
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IJSRuntime JS
@inject AuthenticationStateProvider Auth
@inject PatientAccessService Access
@inject DoctorService Doctors
@inject FamilyVoiceCallService FamilyCalls

@if (Visible)
{
    <FloatPanel Class="place-guide" LabelledBy="guide-call-title">
        <div class="guide-window @(_listening ? "listening" : null)">
            <button type="button" class="guide-close" aria-label="Close" @onclick="EndSessionAsync">&times;</button>
            <p class="guide-kicker">With you</p>
            <h2 id="guide-call-title">@_title</h2>
            @if (_lines.Count > 0)
            {
                <div class="guide-thread">
                    @foreach (var line in _lines)
                    {
                        <p class="@(line.FromUser ? "guide-user" : "guide-assistant")">@line.Text</p>
                    }
                </div>
            }
            <p class="guide-prompt">@_prompt</p>
            <div class="guide-status" aria-live="polite">
                @if (!string.IsNullOrWhiteSpace(_callError))
                {
                    <p class="guide-error">@_callError</p>
                }
                else if (_placing)
                {
                    <p class="guide-calling">Calling</p>
                }
                else if (!_connected && !_ending)
                {
                    <p class="guide-listening">@(_listening ? "I'm listening. Take your time." : "One moment")</p>
                    <div class="guide-choices">
                        @if (_offerKind)
                        {
                            <button type="button" @onclick='() => AnswerAsync("family")'>My family</button>
                            <button type="button" @onclick='() => AnswerAsync("doctor")'>A doctor</button>
                        }
                        @if (_offerYesNo)
                        {
                            <button type="button" @onclick='() => AnswerAsync("yes")'>@_yesLabel</button>
                            <button type="button" @onclick='() => AnswerAsync("no")'>@_noLabel</button>
                        }
                    </div>
                }
                <button type="button" class="guide-end" @onclick="EndSessionAsync">End</button>
            </div>
            @if (_connected)
            {
                <p class="guide-note">You're connected. Please go ahead whenever you're ready.</p>
            }
            else if (!_placing && !_ending)
            {
                <p class="guide-note">You can say yes, no, or end. I'll wait a minute so you don't have to rush.</p>
            }
        </div>
    </FloatPanel>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string? Seed { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private bool _armed;
    private bool _goodbyeClosed;
    private bool _disposed;
    private bool _ending;
    private bool _listening;
    private bool _placing;
    private bool _connected;
    private bool _offerKind;
    private bool _offerYesNo;
    private bool _familyAudio;
    private int _session;
    private int _guideSession;
    private string _title = "How can I help";
    private string _yesLabel = "Yes";
    private string _noLabel = "No";
    private string _prompt = "";
    private string? _callError;
    private bool _committing;
    private bool _listenAfter;
    private readonly List<GuideLine> _lines = new();
    private CancellationTokenSource? _patience;
    private CallGuide? _guide;
    private IJSObjectReference? _speech;
    private IJSObjectReference? _calls;
    private DotNetObjectReference<GuideCallModal>? _self;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !_armed)
        {
            _armed = true;
            _ending = false;
            _goodbyeClosed = false;
            _listening = false;
            _placing = false;
            _connected = false;
            _callError = null;
            _offerKind = false;
            _offerYesNo = false;
            await StartAsync();
        }
        else if (!Visible && _armed)
        {
            _armed = false;
            StopGuide();
        }
    }

    private async Task StartAsync()
    {
        StopGuide();
        var session = ++_session;
        var state = await Auth.GetAuthenticationStateAsync();
        var user = state.User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId) || _disposed || session != _session)
            return;

        var name = user.Identity?.Name;
        var caller = await Access.GetEmergencyCallerAsync(userId);
        var familyContact = await Access.GetFamilyContactAsync(userId);
        var doctors = await Doctors.GetDoctorsAsync(userId);
        if (_disposed || session != _session || !Visible)
            return;

        var family = new List<GuidePerson>();
        if (!string.IsNullOrWhiteSpace(familyContact.Name) && PhoneNumbers.ToE164(familyContact.Phone) is not null)
            family.Add(new GuidePerson("family", familyContact.Name.Trim(), familyContact.Phone!.Trim()));

        var doctorPeople = doctors
            .Where(doctor => !string.IsNullOrWhiteSpace(doctor.Name))
            .Select(doctor => new GuidePerson(
                "doctor",
                doctor.Name.Trim(),
                doctor.PhoneNumber?.Trim() ?? "",
                string.IsNullOrWhiteSpace(doctor.Specialty) ? null : doctor.Specialty.Trim()))
            .ToList();

        _lines.Clear();
        var displayName = string.IsNullOrWhiteSpace(caller.Name) ? name : caller.Name;
        _guide = new CallGuide(displayName, family, doctorPeople);
        var firstName = displayName?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        _title = string.IsNullOrWhiteSpace(firstName) ? "Hi there" : $"Hi, {firstName}";
        var turn = _guide.Begin();
        if (_guide.IsClearChoice(Seed))
            turn = _guide.Hear(Seed);
        _prompt = "";
        await ApplyTurnAsync(session, turn);
    }

    private async Task AnswerAsync(string transcript)
    {
        if (_guide is null || _placing || _connected || _ending)
            return;

        var session = _session;
        await StopSpeechAsync();
        ArchivePrompt();
        Remember(true, Said(transcript));
        var turn = _guide.Hear(transcript);
        await ApplyTurnAsync(session, turn);
    }

    private async Task ApplyTurnAsync(int session, GuideTurn turn)
    {
        if (_disposed || session != _session || !Visible)
            return;

        CancelPatience();
        _prompt = turn.Prompt;
        _offerKind = turn.OfferKind;
        _offerYesNo = turn.OfferYesNo;
        _yesLabel = string.IsNullOrWhiteSpace(turn.YesLabel) ? "Yes" : turn.YesLabel;
        _noLabel = string.IsNullOrWhiteSpace(turn.NoLabel) ? "No" : turn.NoLabel;
        _listening = false;
        await InvokeAsync(StateHasChanged);

        if (turn.End)
        {
            await EndSessionAsync();
            return;
        }

        if (turn.Call is not null)
        {
            _title = turn.Call.Name;
            await PlaceCallAsync(session, turn.Call);
            return;
        }

        await SpeakAsync(session, turn.Prompt, turn.Slow, turn.Listen);
    }

    private async Task SpeakAsync(int session, string prompt, bool slow, bool listenAfter)
    {
        try
        {
            _speech ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Widgets/GuideCallModal.razor.js");
            _self ??= DotNetObjectReference.Create(this);
            _guideSession = session;
            _listenAfter = listenAfter;
            _listening = false;
            await _speech.InvokeVoidAsync("speakGuide", prompt, slow, _self);
            if (!listenAfter && session == _session)
                await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            if (listenAfter && session == _session)
                _listening = false;
        }
    }

    [JSInvokable]
    public async Task OnGuideSpoken()
    {
        if (_disposed || _ending || _guideSession != _session || _placing || _connected)
            return;

        if (!_listenAfter)
        {
            _listening = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _committing = false;
        _listening = true;
        StartPatience(_session);
        await InvokeAsync(StateHasChanged);
        try
        {
            if (_speech is not null && _self is not null)
                await _speech.InvokeVoidAsync("listenGuide", _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            _listening = false;
            CancelPatience();
        }
    }

    private void StartPatience(int session)
    {
        CancelPatience();
        var wait = new CancellationTokenSource();
        _patience = wait;
        _ = WaitForAnswerAsync(session, wait.Token);
    }

    private async Task WaitForAnswerAsync(int session, CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(60), token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed || token.IsCancellationRequested || session != _session || _guide is null || !_listening || _committing || _placing || _connected || _ending)
            return;

        _committing = true;
        _listening = false;
        ArchivePrompt();
        await ApplyTurnAsync(session, _guide.StillHere());
    }

    private void CancelPatience()
    {
        var wait = _patience;
        _patience = null;
        if (wait is null)
            return;

        wait.Cancel();
        wait.Dispose();
    }

    [JSInvokable]
    public Task OnGuideHeard(string transcript)
    {
        if (_disposed || _ending || _guideSession != _session || _guide is null)
            return Task.CompletedTask;

        if (CallGuide.WantsToEnd(transcript))
        {
            CancelPatience();
            return EndSessionAsync();
        }

        if (_placing || _connected || _committing)
            return Task.CompletedTask;

        if (transcript == "\u0000")
        {
            CancelPatience();
            _listening = false;
            return InvokeAsync(StateHasChanged);
        }

        if (!_guide.IsDecisive(transcript))
            return Task.CompletedTask;

        _committing = true;
        _listening = false;
        CancelPatience();
        ArchivePrompt();
        Remember(true, Said(transcript));
        return ApplyTurnAsync(_session, _guide.Hear(transcript));
    }

    private void ArchivePrompt()
    {
        if (!string.IsNullOrWhiteSpace(_prompt))
            Remember(false, _prompt);
    }

    private void Remember(bool fromUser, string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return;

        _lines.Add(new GuideLine(fromUser, text.Trim()));
        while (_lines.Count > 6)
            _lines.RemoveAt(0);
    }

    private static string Said(string transcript) => transcript.Trim().ToLowerInvariant() switch
    {
        "family" => "My family",
        "doctor" => "A doctor",
        "yes" => "Yes",
        "no" => "No",
        _ => transcript.Trim()
    };

    private sealed record GuideLine(bool FromUser, string Text);

    private async Task PlaceCallAsync(int session, GuidePerson person)
    {
        _placing = true;
        _listening = false;
        _offerKind = false;
        _offerYesNo = false;
        await InvokeAsync(StateHasChanged);
        await StopSpeechAsync();
        if (_speech is not null)
        {
            try
            {
                await _speech.InvokeVoidAsync("stopGuide");
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
            {
            }
        }

        var state = await Auth.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId) || _disposed || session != _session)
            return;

        var setup = await FamilyCalls.PrepareDirectoryCallAsync(userId, person.Kind, person.Name, CancellationToken.None);
        if (_disposed || session != _session || !Visible)
            return;
        if (!setup.Ok || setup.Token is null || setup.Ticket is null)
        {
            _placing = false;
                _callError = setup.Error ?? "I'm sorry, the call could not be placed.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            _calls ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Widgets/QuickCallModal.razor.js");
            _self ??= DotNetObjectReference.Create(this);
            _familyAudio = true;
            _guideSession = session;
            await _calls.InvokeVoidAsync("startFamilyCall", setup.Token, setup.Ticket, _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            if (session == _session)
            {
                _familyAudio = false;
                _placing = false;
                _callError = "Please allow the microphone so you can talk.";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public Task OnFamilyCallConnected()
    {
        if (_disposed || _ending || _guideSession != _session)
            return Task.CompletedTask;

        _placing = false;
        _connected = true;
        _callError = null;
        _prompt = "You're connected. Please go ahead whenever you're ready.";
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnFamilyCallEnded()
    {
        if (_disposed || _ending || _guideSession != _session)
            return Task.CompletedTask;
        if (!_connected && !string.IsNullOrWhiteSpace(_callError))
            return Task.CompletedTask;

        return EndSessionAsync();
    }

    [JSInvokable]
    public Task OnGuideEnd(string transcript) => EndSessionAsync();

    [JSInvokable]
    public Task OnGoodbyeSpoken() => FinishCloseAsync();

    private async Task EndSessionAsync()
    {
        if (_disposed || _ending)
            return;

        _ending = true;
        _listening = false;
        _committing = true;
        CancelPatience();
        _prompt = "Goodbye.";
        await InvokeAsync(StateHasChanged);

        try
        {
            _speech ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Widgets/GuideCallModal.razor.js");
            _self ??= DotNetObjectReference.Create(this);
            await _speech.InvokeVoidAsync("speakGoodbye", _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            await FinishCloseAsync();
        }
    }

    private async Task FinishCloseAsync()
    {
        if (_disposed || _goodbyeClosed)
            return;

        _goodbyeClosed = true;
        StopGuide();
        _connected = false;
        _placing = false;
        _armed = false;
        await VisibleChanged.InvokeAsync(false);
    }

    [JSInvokable]
    public Task OnFamilyCallError(string message)
    {
        if (_disposed || _ending || _guideSession != _session)
            return Task.CompletedTask;
        if (_connected && !string.IsNullOrWhiteSpace(message)
            && (message.Contains("hangup", StringComparison.OrdinalIgnoreCase) || message.Contains("31005", StringComparison.Ordinal)))
            return EndSessionAsync();

        _familyAudio = false;
        _placing = false;
        _connected = false;
        _callError = string.IsNullOrWhiteSpace(message) ? "I'm sorry, the call could not be placed." : message.Trim();
        return InvokeAsync(StateHasChanged);
    }

    private void StopGuide()
    {
        _session++;
        _listening = false;
        _committing = false;
        CancelPatience();
        _ = StopSessionAsync();
        if (_familyAudio)
        {
            _familyAudio = false;
            _ = EndCallAsync();
        }
    }

    private async Task StopSessionAsync()
    {
        if (_speech is null)
            return;
        try
        {
            await _speech.InvokeVoidAsync("stopGuide");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private async Task StopSpeechAsync()
    {
        if (_speech is null)
            return;
        try
        {
            await _speech.InvokeVoidAsync("stopGuideSpeech");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private async Task EndCallAsync()
    {
        if (_calls is null)
            return;
        try
        {
            await _calls.InvokeVoidAsync("endFamilyCall");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    public void Dispose()
    {
        if (_disposed)
            return;
        _disposed = true;
        StopGuide();
        _self?.Dispose();
        _ = _speech?.DisposeAsync().AsTask();
        _ = _calls?.DisposeAsync().AsTask();
    }
}
