@namespace MedicalManager.Components.Widgets
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@(Embedded ? "daily-embedded-chart" : "chart-card monthly-chart-card")"
     style="@(Embedded ? null : $"border-top: 5px solid {Accent}")">
    @if (Embedded)
    {
        <div class="daily-embedded-toolbar">
            <div class="chart-type-toggle" role="group" aria-label="Chart type">
                <button type="button"
                        class="@(_mode == DisplayMode.Line ? "active" : null)"
                        aria-pressed="@(_mode == DisplayMode.Line)"
                        @onclick="() => SetMode(DisplayMode.Line)">Line</button>
                <button type="button"
                        class="@(_mode == DisplayMode.Bar ? "active" : null)"
                        aria-pressed="@(_mode == DisplayMode.Bar)"
                        @onclick="() => SetMode(DisplayMode.Bar)">Bar</button>
            </div>
        </div>
    }
    else
    {
        <div class="chart-card-head monthly-chart-head">
            <span class="chart-dot" style="background:@Accent"></span>
            <div class="monthly-chart-title">
                <h3>@Title</h3>
                <p>@Subtitle</p>
            </div>
            <div class="monthly-chart-toolbar">
                <div class="chart-type-toggle" role="group" aria-label="Chart type">
                    <button type="button"
                            class="@(_mode == DisplayMode.Line ? "active" : null)"
                            aria-pressed="@(_mode == DisplayMode.Line)"
                            @onclick="() => SetMode(DisplayMode.Line)">Line</button>
                    <button type="button"
                            class="@(_mode == DisplayMode.Bar ? "active" : null)"
                            aria-pressed="@(_mode == DisplayMode.Bar)"
                            @onclick="() => SetMode(DisplayMode.Bar)">Bar</button>
                </div>
                <div class="monthly-date-nav">
                    <CardPrintButton Label="@PrintButtonLabel" OnClick="PrintAsync" />
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary daily-date-btn"
                            aria-label="Previous month"
                            disabled="@(!CanGoPrevious)"
                            @onclick="GoPrevMonth">&lsaquo;</button>
                    <span class="monthly-date-label">
                        @MonthStart.ToString("MMMM yyyy")
                        @if (IsCurrentMonth)
                        {
                            <span class="day-badge">This month</span>
                        }
                    </span>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary daily-date-btn"
                            aria-label="Next month"
                            disabled="@IsCurrentMonth"
                            @onclick="GoNextMonth">&rsaquo;</button>
                </div>
            </div>
        </div>
    }

    @if (Stats.Count > 0)
    {
        @RenderStatsRow()
    }

    @if (!HasData)
    {
        <div class="@(Embedded ? "empty-chart daily-embedded-empty" : "empty-chart")">
            @(Embedded ? EmptyMessage : $"No readings in {MonthStart.ToString("MMMM yyyy")}. Use the arrows to change months.")
        </div>
    }
    else
    {
        <div class="chart-pan-scroll">
            <div @ref="_host"
                 class="chart-interactive @(Embedded ? "chart-interactive-daily" : "chart-interactive-monthly")"
                 @onmousemove="OnChartMove"
                 @onmouseleave="ClearHover">
                @RenderChart(_hoverIndex)
                @if (_hoverIndex >= 0)
                {
                    @RenderTooltip(_hoverIndex, _tooltipLeft, _tooltipTop)
                }
            </div>
        </div>
        <div class="chart-labels @(Embedded ? "daily-embedded-labels" : "monthly-chart-labels")">
            <span>@StartLabel</span>
            <span>Hover to trace values</span>
            <span>@EndLabel</span>
        </div>
        @if (Series.Count > 1)
        {
            <div class="chart-legend">
                @foreach (var series in Series)
                {
                    <span><i style="background:@series.Color"></i>@series.Name</span>
                }
            </div>
        }
    }
</div>

@code {
    private const double FallbackHeight = 220;
    private const double EmbeddedFallbackHeight = 180;
    private const double MinChartWidth = 240;
    private const string OutOfRangeColor = "#b42318";

    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Accent { get; set; } = "#0f766e";
    [Parameter] public List<ChartSeries> Series { get; set; } = [];
    [Parameter] public List<ChartStatItem> Stats { get; set; } = [];
    [Parameter] public DateOnly SelectedMonth { get; set; } = FirstOfCurrentMonth();
    [Parameter] public EventCallback<DateOnly> SelectedMonthChanged { get; set; }
    [Parameter] public bool CanGoPrevious { get; set; } = true;
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "No readings";
    [Parameter] public string? PatientName { get; set; }
    [Parameter] public string? PatientDateOfBirth { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TrendChart>? _self;
    private bool _observing;
    private double _hostWidth;
    private double _hostHeight;
    private DisplayMode _mode = DisplayMode.Line;
    private int _hoverIndex = -1;
    private double _tooltipLeft;
    private double _tooltipTop;

    private bool HasData => Series.Any(s => s.Points.Count > 0);
    private int PointCount => Series.Where(s => s.Points.Count > 0).Select(s => s.Points.Count).DefaultIfEmpty(0).Max();
    private double ChartWidth => _hostWidth > 0 ? _hostWidth : MinChartWidth;
    private double ChartHeight => _hostHeight > 0 ? _hostHeight : (Embedded ? EmbeddedFallbackHeight : FallbackHeight);
    private DateOnly MonthStart => new(SelectedMonth.Year, SelectedMonth.Month, 1);
    private bool IsCurrentMonth => MonthStart == FirstOfCurrentMonth();
    private string StartLabel => PrimaryPoints.FirstOrDefault().Label ?? "";
    private string EndLabel => PrimaryPoints.LastOrDefault().Label ?? "";
    private string MinLabel => HasData ? Math.Round(AllValues.Min()).ToString() : "";
    private string MaxLabel => HasData ? Math.Round(AllValues.Max()).ToString() : "";
    private IEnumerable<double> AllValues => Series.SelectMany(s => s.Points.Select(p => p.Value));
    private List<ChartPoint> PrimaryPoints => Series.FirstOrDefault(s => s.Points.Count > 0)?.Points ?? [];

    protected override void OnParametersSet()
    {
        if (_hoverIndex >= PointCount)
            _hoverIndex = -1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Widgets/TrendChart.razor.js");
            _self = DotNetObjectReference.Create(this);
        }

        if (_module is null) return;

        if (!HasData)
        {
            _observing = false;
            return;
        }

        if (!_observing)
        {
            await _module.InvokeVoidAsync("observeHost", _host, _self);
            _observing = true;
        }
    }

    [JSInvokable]
    public void OnHostResized(double width, double height)
    {
        if (Math.Abs(width - _hostWidth) < 0.5 && Math.Abs(height - _hostHeight) < 0.5)
            return;

        _hostWidth = width;
        _hostHeight = height;
        _ = InvokeAsync(StateHasChanged);
    }

    private static DateOnly FirstOfCurrentMonth()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return new DateOnly(today.Year, today.Month, 1);
    }

    private void SetMode(DisplayMode mode)
    {
        if (_mode == mode) return;
        _mode = mode;
    }

    private async Task GoPrevMonth()
    {
        if (!CanGoPrevious) return;
        await SelectedMonthChanged.InvokeAsync(MonthStart.AddMonths(-1));
    }

    private async Task GoNextMonth()
    {
        if (IsCurrentMonth) return;
        await SelectedMonthChanged.InvokeAsync(MonthStart.AddMonths(1));
    }

    private RenderFragment RenderChart(int hoverIndex) => builder =>
    {
        var width = ChartWidth;
        var height = ChartHeight;
        var scaled = Scale(width, height).ToList();
        var hoverX = hoverIndex >= 0 ? GetHoverX(scaled, hoverIndex) : (double?)null;

        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "viewBox", $"0 0 {width.ToString("0.##")} {height.ToString("0.##")}");
        builder.AddAttribute(2, "preserveAspectRatio", "none");
        builder.AddAttribute(3, "class", "trend-svg trend-svg-monthly");
        builder.AddAttribute(4, "aria-hidden", "true");

        var seq = 5;
        var plotBottom = height - 40;
        var gridTop = 18.0;
        var gridStep = (plotBottom - gridTop) / 4.0;

        for (var i = 0; i <= 4; i++)
        {
            var y = gridTop + i * gridStep;
            builder.OpenElement(seq++, "line");
            builder.AddAttribute(seq++, "x1", 36);
            builder.AddAttribute(seq++, "y1", y);
            builder.AddAttribute(seq++, "x2", width - 12);
            builder.AddAttribute(seq++, "y2", y);
            builder.AddAttribute(seq++, "class", "chart-grid");
            builder.CloseElement();
        }

        if (hoverX is not null)
        {
            builder.OpenElement(seq++, "line");
            builder.AddAttribute(seq++, "x1", hoverX.Value);
            builder.AddAttribute(seq++, "y1", gridTop);
            builder.AddAttribute(seq++, "x2", hoverX.Value);
            builder.AddAttribute(seq++, "y2", plotBottom);
            builder.AddAttribute(seq++, "class", "chart-hover-line");
            builder.CloseElement();
        }

        foreach (var series in scaled)
        {
            if (_mode == DisplayMode.Bar)
            {
                foreach (var bar in series.Bars)
                {
                    var isActive = hoverIndex >= 0 && bar.Index == hoverIndex;
                    var color = bar.IsOutOfRange ? OutOfRangeColor : series.Color;
                    var grow = isActive ? 1.6 : 0;
                    builder.OpenElement(seq++, "rect");
                    builder.AddAttribute(seq++, "x", (bar.X - grow / 2).ToString("0.##"));
                    builder.AddAttribute(seq++, "y", (bar.Y - (isActive ? 2 : 0)).ToString("0.##"));
                    builder.AddAttribute(seq++, "width", (bar.Width + grow).ToString("0.##"));
                    builder.AddAttribute(seq++, "height", (bar.Height + (isActive ? 2 : 0)).ToString("0.##"));
                    builder.AddAttribute(seq++, "rx", "2.5");
                    builder.AddAttribute(seq++, "fill", color);
                    builder.AddAttribute(seq++, "opacity", isActive ? "1" : "0.88");
                    if (isActive) builder.AddAttribute(seq++, "class", "chart-bar-active");
                    builder.CloseElement();
                }
                continue;
            }

            if (series.Area is not null)
            {
                builder.OpenElement(seq++, "path");
                builder.AddAttribute(seq++, "d", series.Area);
                builder.AddAttribute(seq++, "fill", series.Color);
                builder.AddAttribute(seq++, "opacity", "0.16");
                builder.CloseElement();
            }

            for (var i = 1; i < series.Points.Count; i++)
            {
                var prev = series.Points[i - 1];
                var curr = series.Points[i];
                var segmentColor = prev.IsOutOfRange || curr.IsOutOfRange ? OutOfRangeColor : series.Color;
                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", prev.X);
                builder.AddAttribute(seq++, "y1", prev.Y);
                builder.AddAttribute(seq++, "x2", curr.X);
                builder.AddAttribute(seq++, "y2", curr.Y);
                builder.AddAttribute(seq++, "stroke", segmentColor);
                builder.AddAttribute(seq++, "stroke-width", "2.6");
                builder.AddAttribute(seq++, "stroke-linecap", "round");
                builder.CloseElement();
            }

            foreach (var point in series.Points)
            {
                var isActive = hoverIndex >= 0 && point.Index == hoverIndex;
                var pointColor = point.IsOutOfRange ? OutOfRangeColor : series.Color;
                builder.OpenElement(seq++, "circle");
                builder.AddAttribute(seq++, "cx", point.X.ToString("0.##"));
                builder.AddAttribute(seq++, "cy", point.Y.ToString("0.##"));
                builder.AddAttribute(seq++, "r", isActive ? "5.6" : "3.4");
                builder.AddAttribute(seq++, "fill", pointColor);
                if (isActive) builder.AddAttribute(seq++, "class", "chart-point-active");
                builder.CloseElement();
            }
        }

        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", 8);
        builder.AddAttribute(seq++, "y", gridTop + 4);
        builder.AddAttribute(seq++, "class", "chart-axis");
        builder.AddContent(seq++, MaxLabel);
        builder.CloseElement();

        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", 8);
        builder.AddAttribute(seq++, "y", plotBottom - 4);
        builder.AddAttribute(seq++, "class", "chart-axis");
        builder.AddContent(seq++, MinLabel);
        builder.CloseElement();

        builder.CloseElement();
    };

    private RenderFragment RenderTooltip(int index, double left, double top) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "chart-tooltip chart-tooltip-fixed");
        builder.AddAttribute(2, "style", $"left:{left.ToString("0.##")}px;top:{top.ToString("0.##")}px");

        builder.OpenElement(3, "strong");
        builder.AddContent(4, TooltipWhen(index));
        builder.CloseElement();

        foreach (var row in TooltipRows(index))
        {
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "class", "chart-tooltip-row");
            builder.OpenElement(7, "i");
            builder.AddAttribute(8, "style", $"background:{row.Color}");
            builder.CloseElement();
            builder.OpenElement(9, "span");
            if (row.IsOutOfRange) builder.AddAttribute(10, "class", "chart-tooltip-oor");
            builder.AddContent(11, $"{row.Name}: {row.Text}");
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private async Task OnChartMove(MouseEventArgs e)
    {
        if (_module is null) return;

        var svgX = await _module.InvokeAsync<double>("svgXFromClient", _host, e.ClientX);
        var index = FindNearestIndex(svgX);
        if (index < 0)
        {
            ClearHover();
            return;
        }

        _hoverIndex = index;
        _tooltipLeft = e.ClientX + 14;
        _tooltipTop = Math.Max(8, e.ClientY - 72);
        StateHasChanged();
    }

    private void ClearHover()
    {
        _hoverIndex = -1;
        StateHasChanged();
    }

    private int FindNearestIndex(double svgX)
    {
        var scaled = Scale(ChartWidth, ChartHeight).FirstOrDefault();
        if (scaled is null || scaled.Points.Count == 0) return -1;

        var best = 0;
        var bestDist = double.MaxValue;
        for (var i = 0; i < scaled.Points.Count; i++)
        {
            var dist = Math.Abs(scaled.Points[i].X - svgX);
            if (dist < bestDist)
            {
                bestDist = dist;
                best = i;
            }
        }

        return best;
    }

    private static double? GetHoverX(IReadOnlyList<DrawnSeries> scaled, int index)
    {
        foreach (var series in scaled)
        {
            if (index < series.Points.Count)
                return series.Points[index].X;
        }
        return null;
    }

    private string TooltipWhen(int index)
    {
        var point = PrimaryPoints.ElementAtOrDefault(index);
        if (point.RecordedAt != default)
            return point.RecordedAt.ToString("MMM d, yyyy · h:mm tt");
        return point.Label;
    }

    private IEnumerable<(string Name, string Text, string Color, bool IsOutOfRange)> TooltipRows(int index)
    {
        foreach (var series in Series.Where(s => s.Points.Count > 0))
        {
            if (index >= series.Points.Count) continue;
            var point = series.Points[index];
            var text = point.Detail ?? point.Value.ToString("0.##");
            var color = point.IsOutOfRange ? OutOfRangeColor : series.Color;
            yield return (series.Name, text, color, point.IsOutOfRange);
        }
    }

    private RenderFragment RenderStatsRow() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", Embedded ? "chart-stats daily-embedded-stats" : "chart-stats monthly-chart-stats");

        var seq = 2;
        foreach (var stat in Stats)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "chart-stat-item");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "chart-stat-label");
            builder.AddContent(seq++, stat.Label);
            builder.CloseElement();
            builder.OpenElement(seq++, "strong");
            builder.AddAttribute(seq++, "class", stat.IsOutOfRange ? "chart-stat-value out-of-range" : "chart-stat-value");
            if (!stat.IsOutOfRange)
                builder.AddAttribute(seq++, "style", $"color:{Accent}");
            builder.AddContent(seq++, stat.Value);
            builder.CloseElement();
            if (!string.IsNullOrEmpty(stat.SubValue))
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", stat.IsOutOfRange ? "chart-stat-subvalue out-of-range" : "chart-stat-subvalue");
                builder.AddContent(seq++, stat.SubValue);
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private IEnumerable<DrawnSeries> Scale(double chartWidth, double chartHeight)
    {
        if (!HasData) yield break;

        var min = AllValues.Min();
        var max = AllValues.Max();
        if (Math.Abs(max - min) < 0.01) { min -= 1; max += 1; }

        const double leftPad = 40;
        const double rightPad = 12;
        var plotWidth = chartWidth - leftPad - rightPad;
        var plotBottom = chartHeight - 40;
        const double plotTop = 22;
        var plotHeight = plotBottom - plotTop;
        var activeSeries = Series.Where(s => s.Points.Count > 0).ToList();
        var seriesCount = Math.Max(1, activeSeries.Count);

        for (var s = 0; s < activeSeries.Count; s++)
        {
            var series = activeSeries[s];
            var count = series.Points.Count;
            var points = new List<DrawnPoint>();
            var bars = new List<DrawnBar>();
            for (var i = 0; i < count; i++)
            {
                var centerX = count == 1 ? leftPad + plotWidth / 2 : leftPad + i * (plotWidth / (count - 1));
                var y = plotBottom - ((series.Points[i].Value - min) / (max - min) * plotHeight);
                points.Add(new DrawnPoint(i, centerX, y, series.Points[i].IsOutOfRange));

                var slot = count == 1 ? plotWidth * 0.36 : plotWidth / count;
                var groupWidth = Math.Min(slot * 0.72, Math.Max(34, plotWidth / 18));
                var barW = Math.Max(3.5, groupWidth / seriesCount);
                var x = centerX - groupWidth / 2 + s * barW;
                var height = Math.Max(2, plotBottom - y);
                bars.Add(new DrawnBar(i, x, y, barW - 1.1, height, series.Points[i].IsOutOfRange));
            }

            string? area = null;
            if (points.Count > 0)
            {
                var line = string.Join(" ", points.Select(p => $"{p.X:0.##},{p.Y:0.##}"));
                area = $"M {points[0].X:0.##} {plotBottom} L {line.Replace(" ", " L ")} L {points[^1].X:0.##} {plotBottom} Z";
            }

            yield return new DrawnSeries(series.Color, area, points, bars);
        }
    }

    private string PrintButtonLabel =>
        Title.Contains("sugar", StringComparison.OrdinalIgnoreCase)
            ? "Print blood sugar monthly trend"
            : "Print blood pressure monthly trend";

    private string PrintDocTitle =>
        Title.Contains("sugar", StringComparison.OrdinalIgnoreCase)
            ? "Blood Sugar — Monthly Trend"
            : "Blood Pressure — Monthly Trend";

    private async Task PrintAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Widgets/TrendChart.razor.js");
        var print = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cardPrint.js");

        var stats = Stats.Select(s => new
        {
            label = s.Label,
            value = s.Value,
            subValue = s.SubValue,
            outOfRange = s.IsOutOfRange
        }).ToList();

        var isBp = Series.Count > 1;
        var rows = new List<object>();
        for (var i = 0; i < PointCount; i++)
        {
            var when = i < PrimaryPoints.Count ? PrimaryPoints[i].RecordedAt : default;
            var date = when == default
                ? (i < PrimaryPoints.Count ? PrimaryPoints[i].Label : "")
                : when.ToString("MMM d, yyyy");
            var time = when == default ? "—" : when.ToString("h:mm tt");

            if (isBp)
            {
                var sys = Series[0].Points.ElementAtOrDefault(i);
                var dia = Series.Count > 1 ? Series[1].Points.ElementAtOrDefault(i) : default;
                var tag = VitalStatus.ForBloodPressure((int)Math.Round(sys.Value), (int)Math.Round(dia.Value));
                rows.Add(new
                {
                    cells = new[]
                    {
                        date,
                        time,
                        sys.Value.ToString("0"),
                        dia.Value.ToString("0"),
                        tag.Label
                    },
                    highlight = tag.CssClass == "status-danger"
                });
            }
            else
            {
                var point = Series[0].Points[i];
                var tag = SugarStatusFromPoint(point);
                var kind = SugarKindFromDetail(point.Detail);
                rows.Add(new
                {
                    cells = new[]
                    {
                        date,
                        time,
                        $"{point.Value:0} mg/dL",
                        kind,
                        tag.Label
                    },
                    highlight = tag.CssClass == "status-danger"
                });
            }
        }

        var table = new
        {
            heading = $"Readings · {MonthStart:MMMM yyyy}",
            columns = isBp
                ? new[] { "Date", "Time", "Systolic", "Diastolic", "Status" }
                : new[] { "Date", "Time", "Reading", "Kind", "Status" },
            rows,
            emptyMessage = $"No readings in {MonthStart:MMMM yyyy}."
        };

        var legend = Series
            .Where(s => s.Points.Count > 0)
            .Select(s => new { name = s.Name, color = s.Color })
            .ToList();

        var card = _host;
        await print.InvokeVoidAsync("printCard", card, new
        {
            title = PrintDocTitle,
            subtitle = Subtitle,
            patientName = PatientName,
            dateOfBirth = PatientDateOfBirth,
            periodCaption = "Month",
            periodLabel = MonthStart.ToString("MMMM yyyy"),
            stats,
            tables = new[] { table },
            includeChart = HasData,
            chartCaption = "Monthly trend",
            legend
        });
        await print.DisposeAsync();
    }

    private static StatusTag SugarStatusFromPoint(ChartPoint point)
    {
        var kindText = SugarKindFromDetail(point.Detail);
        if (Enum.TryParse<SugarKind>(kindText, out var kind))
            return VitalStatus.ForSugar((decimal)point.Value, kind);
        return point.IsOutOfRange
            ? new StatusTag("Out of range", "status-danger")
            : new StatusTag("In range", "status-ok");
    }

    private static string SugarKindFromDetail(string? detail)
    {
        if (string.IsNullOrWhiteSpace(detail) || !detail.Contains(" · ", StringComparison.Ordinal))
            return "";
        return detail.Split(" · ").Last().Trim();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                if (_observing)
                    await _module.InvokeVoidAsync("disposeHost", _host);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            _observing = false;
            _self?.Dispose();
        }
    }

    public readonly record struct ChartPoint(
        string Label,
        double Value,
        DateTime RecordedAt = default,
        string? Detail = null,
        bool IsOutOfRange = false);

    public sealed class ChartSeries
    {
        public string Name { get; set; } = "";
        public string Color { get; set; } = "#0f766e";
        public List<ChartPoint> Points { get; set; } = [];
    }

    private enum DisplayMode { Line, Bar }
    private sealed record DrawnPoint(int Index, double X, double Y, bool IsOutOfRange);
    private sealed record DrawnBar(int Index, double X, double Y, double Width, double Height, bool IsOutOfRange);
    private sealed record DrawnSeries(string Color, string? Area, List<DrawnPoint> Points, List<DrawnBar> Bars);
}
