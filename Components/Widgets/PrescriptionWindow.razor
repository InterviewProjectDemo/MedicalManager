@inject VirtualVisitService Visits
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_panel" class="rx-window" style="@Style" role="dialog" aria-modal="false" aria-labelledby="rx-title">
    <div @ref="_grip"
         class="rx-titlebar"
         @onpointerdown="BeginDrag"
         @onpointermove="Drag"
         @onpointerup="EndDrag"
         @onpointercancel="EndDrag">
        <strong id="rx-title">Prescription</strong>
        <span class="rx-actions" @onpointerdown:stopPropagation="true">
            <button type="button" class="window-fit" title="Full screen" aria-label="Full screen" @onclick="FullScreen">
                <span class="studio-float-glyph is-full" aria-hidden="true"></span>
            </button>
            <button type="button" class="window-fit" title="Reduce size" aria-label="Reduce size" @onclick="Reduce">
                <span class="studio-float-glyph is-reduce" aria-hidden="true"></span>
            </button>
            <button type="button" class="rx-close" @onclick="Close" aria-label="Close">&times;</button>
        </span>
    </div>
    <div class="rx-body">
        @if (_desk is null)
        {
            <p class="muted mb-0">Loading patients...</p>
        }
        else if (_desk.Patients.Count == 0)
        {
            <p>No patient has approved lab update or medication access.</p>
            <p class="mb-0"><a href="patients">Patients → Request patient access</a></p>
        }
        else
        {
            @if (_desk.Patients.Count > 1)
            {
                <label class="form-label" for="rx-patient">Patient</label>
                <select id="rx-patient" class="form-select mb-3" value="@_patientId" @onchange="OnPatient">
                    @foreach (var patient in _desk.Patients)
                    {
                        <option value="@patient.PatientId">@patient.PatientName</option>
                    }
                </select>
            }
            else
            {
                <p class="muted">Patient: <strong>@_patientName</strong></p>
            }

            <fieldset class="rx-choices">
                <legend>Include</legend>
                <label class="@(!LabAllowed ? "is-disabled" : null)">
                    <input type="checkbox" disabled="@(!LabAllowed)" checked="@_orderLabs" @onchange="OnLabs" />
                    Lab
                </label>
                <label class="@(!MedAllowed ? "is-disabled" : null)">
                    <input type="checkbox" disabled="@(!MedAllowed)" checked="@_orderMeds" @onchange="OnMeds" />
                    Medication
                </label>
                @if (MedPageAllowed)
                {
                    <a class="btn btn-sm btn-outline-success" href="@CareLinks.To("medications", _patientId)">Medication</a>
                }
            </fieldset>
            @if (!LabAllowed)
            {
                <p class="muted rx-denied">Lab: This patient has not approved your access to this part of the chart.</p>
            }
            @if (!MedAllowed)
            {
                <p class="muted rx-denied">Medication: This patient has not approved your access to this part of the chart.</p>
            }

            @if (_orderLabs && LabAllowed)
            {
                <p class="muted rx-lead">Outpatient order sheet. A group checkbox selects every test in that group. CMP and BMP share the same chart columns, so overlapping analytes are ordered once.</p>
                @foreach (var group in LabOrderCatalog.Groups)
                {
                    <section class="rx-group">
                        <label class="rx-group-title">
                            <input type="checkbox" checked="@GroupChecked(group)" @onchange="e => ToggleGroup(group, e)" />
                            @group.Name
                        </label>
                        <div class="rx-items">
                            @foreach (var item in group.Items)
                            {
                                <label class="rx-item">
                                    <input type="checkbox" checked="@_selected.Contains(item.Id)" @onchange="e => Toggle(item.Id, e)" />
                                    <span>
                                        <strong>@item.Name</strong>
                                        <small>@LabOrderCatalog.AnalyteLabel(item)</small>
                                    </span>
                                </label>
                            }
                        </div>
                    </section>
                }
            }

            @if (_orderMeds && MedAllowed)
            {
                <section class="rx-meds">
                    <p class="muted rx-lead">Medication order. Add one row for each medicine. A clock time such as 8:00 AM is saved with the schedule.</p>
                    @foreach (var draft in _drafts)
                    {
                        <div class="rx-med-row">
                            <input class="form-control" placeholder="Name" aria-label="Medication name" value="@draft.Name" @oninput="e => SetDraft(draft, e, nameof(MedDraft.Name))" />
                            <input class="form-control" placeholder="Dose" aria-label="Dose" value="@draft.Dose" @oninput="e => SetDraft(draft, e, nameof(MedDraft.Dose))" />
                            <input class="form-control" placeholder="Time / schedule" aria-label="Time or schedule" value="@draft.Schedule" @oninput="e => SetDraft(draft, e, nameof(MedDraft.Schedule))" />
                            <input class="form-control" placeholder="Purpose" aria-label="Purpose" value="@draft.Purpose" @oninput="e => SetDraft(draft, e, nameof(MedDraft.Purpose))" />
                            @if (_drafts.Count > 1)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => RemoveDraft(draft)">Remove</button>
                            }
                        </div>
                    }
                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="AddDraft">Add another medication</button>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger py-2" role="alert">@_error</div>
            }
            @if (!string.IsNullOrWhiteSpace(_saved))
            {
                <div class="alert alert-success py-2" role="status">
                    @_saved
                    @if (_savedLabs)
                    {
                        <a href="@CareLinks.To("labs", _patientId)">Open lab chart</a>
                    }
                    @if (_savedMeds)
                    {
                        <a href="@CareLinks.To("medications", _patientId)">Open medication page</a>
                    }
                </div>
            }

            <div class="rx-foot">
                <button type="button" class="btn btn-teal" disabled="@_saving" @onclick="SubmitAsync">Submit</button>
                <span class="muted">@(_orderLabs ? $"{_selected.Count} labs" : "")@(_orderLabs && _orderMeds ? " · " : "")@(_orderMeds ? $"{FilledDrafts} medications" : "")</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback Closed { get; set; }

    private VisitAccess? _desk;
    private string? _patientId;
    private string? _patientName;
    private readonly HashSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);
    private string? _error;
    private string? _saved;
    private bool _saving;
    private bool _orderLabs;
    private bool _orderMeds;
    private bool _savedLabs;
    private bool _savedMeds;
    private readonly List<MedDraft> _drafts = [new()];

    private DoctorGrantItem? Selected =>
        _desk?.Patients.FirstOrDefault(patient => patient.PatientId == _patientId);

    private bool LabAllowed => Selected?.Lab == ChartAccessLevel.Update;

    private bool MedAllowed => Selected?.Medication == ChartAccessLevel.Update;

    private bool MedPageAllowed => Selected?.Medication != ChartAccessLevel.None;

    private int FilledDrafts => _drafts.Count(draft =>
        !string.IsNullOrWhiteSpace(draft.Name)
        || !string.IsNullOrWhiteSpace(draft.Dose)
        || !string.IsNullOrWhiteSpace(draft.Schedule));

    private readonly string _modulePath = "./Components/Widgets/FloatPanel.razor.js";
    private IJSObjectReference? _module;
    private ElementReference _panel;
    private ElementReference _grip;
    private bool _dragging;
    private bool _placed;
    private bool _sized;
    private int _dragToken;
    private bool _disposed;
    private double _startX;
    private double _startY;
    private double _originLeft;
    private double _originTop;
    private double _left;
    private double _top;
    private double _width;
    private double _height;
    private double _viewWidth = 1280;
    private double _viewHeight = 800;

    private string Style => !_placed
        ? ""
        : !_sized
            ? FormattableString.Invariant($"left:{_left:0.0}px;top:{_top:0.0}px;right:auto;bottom:auto;transform:none;")
            : FormattableString.Invariant($"left:{_left:0.0}px;top:{_top:0.0}px;width:{_width:0.0}px;height:{_height:0.0}px;max-width:none;max-height:none;right:auto;bottom:auto;transform:none;");

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var access = await Visits.OpenAsync(state.User, labUpdateOnly: false);
        if (access.IsDoctor)
        {
            var patients = access.Patients
                .Where(patient => patient.Lab == ChartAccessLevel.Update || patient.Medication != ChartAccessLevel.None)
                .ToList();
            _desk = access with { Patients = patients };
        }
        else
        {
            _desk = access;
        }

        var first = _desk.Patients.FirstOrDefault();
        _patientId = first?.PatientId;
        _patientName = first?.PatientName;
        SyncChoices();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", _modulePath);
            await _module.InvokeVoidAsync("layer", _panel);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private void OnPatient(ChangeEventArgs e)
    {
        _patientId = e.Value?.ToString();
        _patientName = _desk?.Patients.FirstOrDefault(patient => patient.PatientId == _patientId)?.PatientName;
        _saved = null;
        SyncChoices();
    }

    private void SyncChoices()
    {
        if (!LabAllowed)
            _orderLabs = false;
        if (!MedAllowed)
            _orderMeds = false;
    }

    private void OnLabs(ChangeEventArgs e)
    {
        if (!LabAllowed)
            return;
        _orderLabs = e.Value is bool on && on;
        _saved = null;
    }

    private void OnMeds(ChangeEventArgs e)
    {
        if (!MedAllowed)
            return;
        _orderMeds = e.Value is bool on && on;
        _saved = null;
    }

    private static void SetDraft(MedDraft draft, ChangeEventArgs e, string field)
    {
        var value = e.Value?.ToString() ?? "";
        if (field == nameof(MedDraft.Name))
            draft.Name = value;
        else if (field == nameof(MedDraft.Dose))
            draft.Dose = value;
        else if (field == nameof(MedDraft.Schedule))
            draft.Schedule = value;
        else
            draft.Purpose = value;
    }

    private void AddDraft() => _drafts.Add(new MedDraft());

    private void RemoveDraft(MedDraft draft)
    {
        _drafts.Remove(draft);
        if (_drafts.Count == 0)
            _drafts.Add(new MedDraft());
        _saved = null;
    }

    private bool GroupChecked(LabOrderGroup group) =>
        group.Items.Count > 0 && group.Items.All(item => _selected.Contains(item.Id));

    private void ToggleGroup(LabOrderGroup group, ChangeEventArgs e)
    {
        var on = e.Value is bool value && value;
        foreach (var item in group.Items)
        {
            if (on)
                _selected.Add(item.Id);
            else
                _selected.Remove(item.Id);
        }

        _saved = null;
    }

    private void Toggle(string id, ChangeEventArgs e)
    {
        if (e.Value is bool on && on)
            _selected.Add(id);
        else
            _selected.Remove(id);
        _saved = null;
    }

    private async Task SubmitAsync()
    {
        if (_desk is null || string.IsNullOrWhiteSpace(_patientId))
            return;

        _saving = true;
        _error = null;
        _saved = null;
        _savedLabs = false;
        _savedMeds = false;
        try
        {
            if (!_orderLabs && !_orderMeds)
                throw new InvalidOperationException("Choose Medication, Lab, or both.");
            if (_orderLabs && _selected.Count == 0)
                throw new InvalidOperationException("Select at least one lab.");

            var notes = new List<string>();
            if (_orderMeds)
            {
                var orders = _drafts
                    .Where(draft => !string.IsNullOrWhiteSpace(draft.Name)
                        || !string.IsNullOrWhiteSpace(draft.Dose)
                        || !string.IsNullOrWhiteSpace(draft.Schedule)
                        || !string.IsNullOrWhiteSpace(draft.Purpose))
                    .Select(draft => new MedicationOrder(draft.Name, draft.Dose, draft.Schedule, draft.Purpose))
                    .ToList();
                var count = await Visits.PrescribeMedicationsAsync(_desk.ActorUserId, _patientId, orders);
                notes.Add(count == 1 ? "1 medication prescribed." : $"{count} medications prescribed.");
                _drafts.Clear();
                _drafts.Add(new MedDraft());
                _savedMeds = true;
            }

            if (_orderLabs)
            {
                await Visits.PrescribeLabsAsync(_desk.ActorUserId, _patientId, _selected.ToArray());
                notes.Add($"Labs prescribed for {_patientName}.");
                _selected.Clear();
                _savedLabs = true;
            }

            _saved = string.Join(" ", notes);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = _savedMeds
                ? $"Medications were saved. {ex.Message}"
                : ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Close() => await Closed.InvokeAsync();

    private Task FullScreen() => FrameAsync("full");

    private Task Reduce() => FrameAsync("reduce");

    private async Task FrameAsync(string mode)
    {
        if (_disposed)
            return;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", _modulePath);
            var box = await _module.InvokeAsync<FloatOrigin>("frame", _panel, mode, "prescription");
            if (_disposed)
                return;
            _left = box.Left;
            _top = box.Top;
            _width = box.Width;
            _height = box.Height;
            _viewWidth = box.ViewWidth > 0 ? box.ViewWidth : _viewWidth;
            _viewHeight = box.ViewHeight > 0 ? box.ViewHeight : _viewHeight;
            _placed = true;
            _sized = true;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private async Task BeginDrag(PointerEventArgs e)
    {
        if (e.Button != 0 || _module is null)
            return;

        var token = ++_dragToken;
        FloatOrigin origin;
        try
        {
            origin = await _module.InvokeAsync<FloatOrigin>("begin", _panel, _grip, e.PointerId);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            return;
        }

        if (token != _dragToken)
            return;

        _startX = e.ClientX;
        _startY = e.ClientY;
        _originLeft = origin.Left;
        _originTop = origin.Top;
        _viewWidth = origin.ViewWidth;
        _viewHeight = origin.ViewHeight;
        _left = _originLeft;
        _top = _originTop;
        _placed = true;
        _dragging = true;
    }

    private void Drag(PointerEventArgs e)
    {
        if (!_dragging)
            return;

        _left = Math.Clamp(_originLeft + e.ClientX - _startX, 8, Math.Max(8, _viewWidth - 120));
        _top = Math.Clamp(_originTop + e.ClientY - _startY, 8, Math.Max(8, _viewHeight - 64));
    }

    private void EndDrag(PointerEventArgs _)
    {
        _dragToken++;
        _dragging = false;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null)
            return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed class MedDraft
    {
        public string Name { get; set; } = "";
        public string Dose { get; set; } = "";
        public string Schedule { get; set; } = "";
        public string Purpose { get; set; } = "";
    }

    private sealed class FloatOrigin
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double ViewWidth { get; set; }
        public double ViewHeight { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }
}
