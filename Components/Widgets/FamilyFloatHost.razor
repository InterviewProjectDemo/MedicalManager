@inject FamilyCallCoordinator FamilyCalls
@inject IJSRuntime JS
@implements IDisposable

<div class="family-float-host" data-family-float>
    <button type="button" class="family-face" aria-label="Call family" @onclick="OpenFamily">
        <span class="portrait-figure">
            <span class="portrait-orb"><img src="/studio/studio-family.jpg" alt="" draggable="false" /></span>
            <span class="portrait-pedestal" aria-hidden="true"></span>
        </span>
        <span class="portrait-stem" aria-hidden="true"></span>
        <span class="portrait-dot" aria-hidden="true"></span>
        <span class="portrait-name">Call family</span>
    </button>
    <button type="button" class="family-menu" aria-label="Return Call family to its place">Back</button>
    <button type="button" class="family-resize" aria-label="Resize Call family"></button>
</div>

@code {
    private DotNetObjectReference<FamilyFloatHost>? _self;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/familyButton.js");
            await _module.InvokeVoidAsync("bind", _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    [JSInvokable]
    public Task OpenFromFace() => OpenFamily();

    private Task OpenFamily() => FamilyCalls.RequestOpenAsync();

    public void Dispose()
    {
        _self?.Dispose();
    }
}
