@using System.Globalization
@using System.Security.Claims
@using MedicalManager.Data.Notifications
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@implements IDisposable
@inject IJSRuntime JS
@inject TwilioNotificationSender Calls
@inject FamilyVoiceCallService FamilyCalls
@inject AuthenticationStateProvider Auth
@inject IOptions<NotificationOptions> NotificationOptions

@if (Visible)
{
    <FloatPanel Class="place-phone" LabelledBy="quick-call-title">
        <div class="quick-call-window @KindClass">
            <button type="button" class="quick-call-close" aria-label="Close" @onclick="CloseAsync">&times;</button>
            <p class="quick-call-kicker">@Kicker</p>
            <div class="quick-call-portrait">
                @if (IsEmergency)
                {
                    <img src="/images/emergency-crew.svg" alt="Ambulance and an EMT" />
                }
                else if (!string.IsNullOrWhiteSpace(PhotoUrl))
                {
                    <img src="@PhotoUrl" alt="" />
                }
                else
                {
                    <span class="quick-call-initials" aria-hidden="true">@Initials</span>
                }
            </div>
            <h2 id="quick-call-title">@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Detail))
            {
                <p class="quick-call-detail">@Detail</p>
            }
            @if (IsEmergency && CanPlaceCall)
            {
                <p class="quick-call-dispatch-label">Provided to the emergency center</p>
                <dl class="quick-call-dispatch">
                    <div>
                        <dt>Name</dt>
                        <dd>@Shown(CallerName)</dd>
                    </div>
                    <div>
                        <dt>Phone</dt>
                        <dd>@Shown(CallerPhone)</dd>
                    </div>
                    <div>
                        <dt>Location</dt>
                        <dd class="quick-call-location">
                            @if (_hasFix)
                            {
                                <span class="quick-call-coords">@CoordinateText</span>
                                <span class="quick-call-accuracy">± @_accuracy!.Value.ToString("0") m</span>
                                @if (_accuracy > PreciseMeters)
                                {
                                    <span class="quick-call-refining">Refining GPS for a tighter pin.</span>
                                }
                                <a class="quick-call-map" href="@MapUrl" target="_blank" rel="noopener noreferrer">Open precise map</a>
                            }
                            else if (!string.IsNullOrWhiteSpace(_gpsError))
                            {
                                <span>@_gpsError</span>
                            }
                            else
                            {
                                <span class="quick-call-locating">Locating with GPS…</span>
                            }
                        </dd>
                    </div>
                </dl>
            }
            <div class="quick-call-status" aria-live="polite">
                @if (IsEmergency && !HasUserPhone)
                {
                    <a class="quick-call-setup" href="profile" @onclick="CloseAsync">Add your phone number</a>
                }
                else if (!IsEmergency && !HasFamilyPhone)
                {
                    <a class="quick-call-setup" href="profile" @onclick="CloseAsync">Set up family contact</a>
                }
                else if (!string.IsNullOrWhiteSpace(_callError))
                {
                    <p class="quick-call-error">@_callError</p>
                }
                else if (_connected)
                {
                    <button type="button" class="quick-call-end" @onclick="CloseAsync">End</button>
                }
                else
                {
                    <p class="quick-call-calling">Calling</p>
                }
            </div>
            @if (IsEmergency && !HasUserPhone)
            {
                <p class="quick-call-note">This call rings the phone number on your profile, the same number used for alerts.</p>
            }
            else if (IsEmergency)
            {
                <p class="quick-call-note">This call rings your phone and includes your name and live GPS location. It does not dial 911.</p>
            }
            else if (!HasFamilyPhone)
            {
                <p class="quick-call-note">Add this person’s name and phone on your Profile page. A photo is optional.</p>
            }
            else if (_connected)
            {
                <p class="quick-call-note">Talk through this device. The microphone and speaker are on.</p>
            }
            else
            {
                <p class="quick-call-note">This call uses this device's microphone and speaker so you can talk with @Shown(ContactName).</p>
            }
        </div>
    </FloatPanel>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Kind { get; set; } = "emergency";
    [Parameter] public string? ContactName { get; set; }
    [Parameter] public string? ContactPhone { get; set; }
    [Parameter] public string? PhotoUrl { get; set; }
    [Parameter] public string? CallerName { get; set; }
    [Parameter] public string? CallerPhone { get; set; }

    private const double PreciseMeters = 25;

    private bool _connected;
    private bool _armed;
    private bool _disposed;
    private string? _callSid;
    private string? _callError;
    private bool _familyAudio;
    private bool _ending;
    private int _familySession;
    private bool _hasFix;
    private int _session;
    private int _watchId;
    private double _latitude;
    private double _longitude;
    private double? _accuracy;
    private string? _gpsError;
    private CancellationTokenSource? _cts;
    private IJSObjectReference? _module;
    private DotNetObjectReference<QuickCallModal>? _gpsRef;

    private string CoordinateText =>
        string.Create(CultureInfo.InvariantCulture, $"{_latitude:0.000000}, {_longitude:0.000000}");

    private string MapUrl =>
        string.Create(CultureInfo.InvariantCulture, $"https://www.google.com/maps/search/?api=1&query={_latitude:0.000000},{_longitude:0.000000}");

    private bool IsEmergency => string.Equals(Kind, "emergency", StringComparison.OrdinalIgnoreCase);

    private bool HasUserPhone => PhoneNumbers.ToE164(CallerPhone) is not null;

    private bool HasFamilyPhone => PhoneNumbers.ToE164(ContactPhone) is not null;

    private bool CanPlaceCall => IsEmergency ? HasUserPhone : HasFamilyPhone;

    private string KindClass => IsEmergency ? "is-emergency" : "is-family";
    private string Kicker => IsEmergency ? "Emergency" : "Family";

    private string Title => IsEmergency
        ? "Emergency services"
        : (string.IsNullOrWhiteSpace(ContactName) ? "No family contact yet" : ContactName.Trim());

    private string? Detail => IsEmergency
        ? "Ambulance and EMT"
        : (HasFamilyPhone ? ContactPhone!.Trim() : null);

    private string Initials => InitialsFrom(ContactName);

    private static string Shown(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not on your profile" : value.Trim();

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !_armed)
        {
            _armed = true;
            _connected = false;
            _callError = null;
            _callSid = null;
            _ending = false;
            ResetGps();
            await StartCallingAsync();
        }
        else if (!Visible && _armed)
        {
            _armed = false;
            _connected = false;
            CancelCalling();
        }
    }

    private async Task StartCallingAsync()
    {
        CancelCalling();
        if (!CanPlaceCall || _disposed)
            return;

        var session = ++_session;
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        if (!IsEmergency)
        {
            await StartFamilyTalkAsync(session);
            return;
        }

        if (IsEmergency)
            _ = WatchGpsAsync(session);

        try
        {
            var started = DateTime.UtcNow;
            while (IsEmergency && !_hasFix && _gpsError is null && DateTime.UtcNow - started < TimeSpan.FromSeconds(4))
                await Task.Delay(200, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_disposed || session != _session || !Visible)
            return;

        var ssml = QuickCallCopy.EmergencySsml(CallerName, CallerPhone, _hasFix ? _latitude : null, _hasFix ? _longitude : null, _accuracy);
        var result = await Calls.CallAsync(CallerPhone!, ssml, NotificationOptions.Value.Voice.PollyVoice, CancellationToken.None);
        if (_disposed || session != _session || !Visible)
        {
            if (!string.IsNullOrWhiteSpace(result.Sid))
                await Calls.EndCallAsync(result.Sid, CancellationToken.None);
            return;
        }

        if (!result.Ok)
        {
            _callError = FriendlyCallError(result.Detail);
            await InvokeAsync(StateHasChanged);
            return;
        }

        _callSid = result.Sid;
        _connected = true;
        if (!string.IsNullOrWhiteSpace(result.Sid))
            _ = WatchEmergencyCallAsync(session, result.Sid);
        await InvokeAsync(StateHasChanged);
    }

    private async Task WatchEmergencyCallAsync(int session, string callSid)
    {
        try
        {
            while (!_disposed && !_ending && session == _session && Visible)
            {
                await Task.Delay(2000);
                if (_disposed || _ending || session != _session || !Visible)
                    return;

                if (await Calls.IsCallFinishedAsync(callSid, CancellationToken.None))
                {
                    await InvokeAsync(CloseFromRemoteAsync);
                    return;
                }
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or ObjectDisposedException)
        {
        }
    }

    private async Task StartFamilyTalkAsync(int session)
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId) || _disposed || session != _session)
            return;

        var setup = await FamilyCalls.PrepareAsync(userId, CancellationToken.None);
        if (_disposed || session != _session || !Visible)
            return;
        if (!setup.Ok || setup.Token is null || setup.Ticket is null)
        {
            _callError = setup.Error ?? "The call could not be placed.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Widgets/QuickCallModal.razor.js");
            _gpsRef ??= DotNetObjectReference.Create(this);
            _familyAudio = true;
            _familySession = session;
            _callSid = null;
            await _module.InvokeVoidAsync("startFamilyCall", setup.Token, setup.Ticket, _gpsRef);
            if (!_disposed && session == _session && Visible)
                _ = WatchFamilyCallAsync(session, setup.Ticket);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            if (session == _session)
            {
                _familyAudio = false;
                var message = ex is JSException js ? js.Message : "";
                _callError = message.Contains("microphone", StringComparison.OrdinalIgnoreCase)
                    ? "Allow the microphone so you can talk."
                    : "The call could not be placed.";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public Task OnFamilyCallConnected()
    {
        if (_disposed || _ending || _familySession != _session)
            return Task.CompletedTask;

        _connected = true;
        _callError = null;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnFamilyCallSid(string callSid)
    {
        if (_disposed || _ending || _familySession != _session || string.IsNullOrWhiteSpace(callSid))
            return Task.CompletedTask;

        _callSid = callSid.Trim();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnFamilyCallEnded()
    {
        if (_disposed || _ending || _familySession != _session)
            return Task.CompletedTask;

        if (FamilyCallSignals.IsSetupFailure(_callError))
            return Task.CompletedTask;

        return InvokeAsync(CloseFromRemoteAsync);
    }

    [JSInvokable]
    public Task OnFamilyCallError(string message)
    {
        if (_disposed || _ending || _familySession != _session)
            return Task.CompletedTask;

        if (FamilyCallSignals.IsTerminal(message))
            return InvokeAsync(CloseFromRemoteAsync);

        _familyAudio = false;
        _connected = false;
        _callError = !string.IsNullOrWhiteSpace(message) && message.Contains("microphone", StringComparison.OrdinalIgnoreCase)
            ? "Allow the microphone so you can talk."
            : "The call could not be placed.";
        return InvokeAsync(StateHasChanged);
    }

    private async Task WatchFamilyCallAsync(int session, string ticket)
    {
        try
        {
            while (!_disposed && !_ending && session == _session && Visible)
            {
                await Task.Delay(2000);
                if (_disposed || _ending || session != _session || !Visible)
                    return;

                if (FamilyCallSignals.IsSetupFailure(_callError)
                    && string.IsNullOrWhiteSpace(_callSid)
                    && !FamilyCalls.IsDialFinished(ticket))
                    return;

                var finished = FamilyCalls.IsDialFinished(ticket);
                if (!finished && !string.IsNullOrWhiteSpace(_callSid))
                    finished = await Calls.IsCallFinishedAsync(_callSid, CancellationToken.None);

                if (finished)
                {
                    await InvokeAsync(CloseFromRemoteAsync);
                    return;
                }
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or ObjectDisposedException)
        {
        }
    }

    private static string FriendlyCallError(string? detail) => detail switch
    {
        "The phone number is not a valid US number." => "Add a 10-digit phone number on your Profile.",
        "Twilio is not ready to send." => "Calling is not available right now.",
        _ => "The call could not be placed."
    };

    private async Task WatchGpsAsync(int session)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Widgets/QuickCallModal.razor.js");
            _gpsRef ??= DotNetObjectReference.Create(this);
            var id = await _module.InvokeAsync<int>("watchGps", _gpsRef);
            if (_disposed || session != _session)
            {
                if (id != 0)
                    await _module.InvokeVoidAsync("stopGps", id);
                return;
            }

            _watchId = id;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            if (session == _session)
            {
                _gpsError = "GPS location is unavailable.";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public Task OnGpsFix(double latitude, double longitude, double accuracy)
    {
        if (_disposed)
            return Task.CompletedTask;
        if (_accuracy is double current && accuracy > current)
            return Task.CompletedTask;

        _latitude = latitude;
        _longitude = longitude;
        _accuracy = accuracy;
        _hasFix = true;
        _gpsError = null;
        if (accuracy <= PreciseMeters && _watchId != 0)
            _ = StopGpsAsync();

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnGpsError(int code)
    {
        if (_disposed || _hasFix)
            return Task.CompletedTask;

        _gpsError = code switch
        {
            1 => "Allow location access so responders can find you.",
            3 => "GPS timed out. Try again outdoors or near a window.",
            _ => "GPS location is unavailable."
        };
        return InvokeAsync(StateHasChanged);
    }

    private void ResetGps()
    {
        _hasFix = false;
        _latitude = 0;
        _longitude = 0;
        _accuracy = null;
        _gpsError = null;
    }

    private async Task StopGpsAsync()
    {
        var id = _watchId;
        _watchId = 0;
        if (id == 0 || _module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("stopGps", id);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    private async Task CloseAsync()
    {
        if (_disposed)
            return;

        _ending = true;
        CancelCalling();
        _connected = false;
        _armed = false;
        _callError = null;
        if (_disposed)
            return;

        await VisibleChanged.InvokeAsync(false);
    }

    private Task CloseFromRemoteAsync()
    {
        if (_disposed || _ending)
            return Task.CompletedTask;

        _callSid = null;
        return CloseAsync();
    }

    private void CancelCalling()
    {
        _session++;
        if (_cts is not null)
        {
            _cts.Cancel();
            _cts.Dispose();
            _cts = null;
        }

        var sid = _callSid;
        _callSid = null;
        if (!string.IsNullOrWhiteSpace(sid))
            _ = Calls.EndCallAsync(sid, CancellationToken.None);

        if (_familyAudio)
        {
            _familyAudio = false;
            _ = EndFamilyAudioAsync();
        }

        _ = StopGpsAsync();
    }

    private async Task EndFamilyAudioAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("endFamilyCall");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    public void Dispose()
    {
        if (_disposed)
            return;

        _disposed = true;
        CancelCalling();
        _gpsRef?.Dispose();
        _ = _module?.DisposeAsync().AsTask();
    }

    private static string InitialsFrom(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
        if (parts[0].Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[0][1])}";
        return char.ToUpperInvariant(parts[0][0]).ToString();
    }
}
