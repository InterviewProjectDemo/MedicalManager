@page "/profile"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims

@inject AuthenticationStateProvider Auth
@inject UserManager<ApplicationUser> UserManager
@inject PatientAccessService Access
@inject ProfilePhotoService PhotoService
@using MedicalManager.Data.Notifications

<PageTitle>Patient Profile</PageTitle>

@if (_loading)
{
    <p class="muted">Loading profile…</p>
}
else if (_user is null)
{
    <div class="alert alert-danger">Unable to load your profile.</div>
}
else
{
    <div class="page-head accent-dash">
        <div>
            <p class="eyebrow">Your account</p>
            <h1>Patient profile</h1>
            <p class="muted">Manage your photo and view your health profile details.</p>
        </div>
    </div>

    <div class="profile-page-card">
        <div class="profile-page-photo-section">
            <button type="button"
                    class="profile-page-photo-wrap"
                    aria-label="Change profile photo"
                    @onclick="OpenPhotoModal">
                @if (!string.IsNullOrWhiteSpace(_photoUrl))
                {
                    <img src="@_photoUrl" alt="" class="profile-page-photo" />
                }
                else
                {
                    <span class="profile-page-photo-placeholder">@GetInitials(_user)</span>
                }
            </button>
            <div class="profile-page-photo-meta">
                <h2>@_user.DisplayName</h2>
                <p class="muted">@_user.Email</p>
                <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="OpenPhotoModal">
                    Change photo
                </button>
            </div>
        </div>

        <dl class="profile-page-details">
            <div>
                <dt>Full name</dt>
                <dd>@(_user.FullName)</dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd>@(_user.Email ?? "—")</dd>
            </div>
            <div>
                <dt>Phone</dt>
                <dd>@(_profile?.Phone ?? _user.PhoneNumber ?? "—")</dd>
            </div>
            <div>
                <dt>Home address</dt>
                <dd>@(string.IsNullOrWhiteSpace(_profile?.HomeAddress) ? "—" : _profile.HomeAddress)</dd>
            </div>
            <div>
                <dt>Date of birth</dt>
                <dd>@(_profile?.DateOfBirth?.ToString("MMMM d, yyyy") ?? "—")</dd>
            </div>
            <div>
                <dt>Sex</dt>
                <dd>@(_profile?.Sex ?? "—")</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(_profile?.Notes))
            {
                <div>
                    <dt>Notes</dt>
                    <dd>@_profile.Notes</dd>
                </div>
            }
        </dl>

        <p class="profile-page-account-hint">
            <a href="Account/Manage">Account settings</a> — update phone number, email, and password.
        </p>
    </div>

    <div class="profile-page-card">
        <h2 class="reminder-settings-title">Appointment reminders</h2>
        <p class="muted">
            One day before a visit, we call and text you. One hour before, we call again.
            The call greets you by your full name, saying your first name and last name clearly, then the time, purpose, and location.
        </p>
        @if (string.IsNullOrWhiteSpace(_profile?.Phone) && string.IsNullOrWhiteSpace(_user.PhoneNumber))
        {
            <div class="alert alert-warning">Add a phone number in account settings so the reminders can reach you.</div>
        }
        <EditForm Model="_reminderForm" OnValidSubmit="SaveReminders" class="mt-3">
            <div class="mb-3">
                <label class="form-label" for="home-address">Home address</label>
                <InputTextArea id="home-address" class="form-control" rows="2" @bind-Value="_reminderForm.HomeAddress" placeholder="123 Main Street, Austin, TX" />
                <div class="form-text">Used to estimate the drive to the appointment. The address stays on your profile.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="name-pronunciation">How should we say your name?</label>
                <InputText id="name-pronunciation" class="form-control" @bind-Value="_reminderForm.NamePronunciation" placeholder="nah-VEEN SHAR-mah" />
                <div class="form-text">
                    Leave this blank to use the spelling @_user.DisplayName.
                    Calls will say: @NameSpeaker.Preview(_user.FullName, _reminderForm.NamePronunciation)
                </div>
            </div>
            <div class="form-check mb-3">
                <InputCheckbox id="reminders-enabled" class="form-check-input" @bind-Value="_reminderForm.RemindersEnabled" />
                <label class="form-check-label" for="reminders-enabled">Call and text me about upcoming appointments</label>
            </div>
            <button type="submit" class="btn btn-purple">Save reminder settings</button>
            @if (!string.IsNullOrWhiteSpace(_reminderMessage))
            {
                <span class="ms-2 muted">@_reminderMessage</span>
            }
        </EditForm>
    </div>

    <ProfilePhotoModal Visible="_photoModalOpen"
                       VisibleChanged="OnPhotoModalVisibleChanged"
                       PhotoSaved="OnPhotoSaved" />
}

@code {
    private bool _loading = true;
    private string? _userId;
    private string? _photoUrl;
    private bool _photoModalOpen;
    private ApplicationUser? _user;
    private PatientProfile? _profile;
    private readonly ReminderForm _reminderForm = new();
    private string? _reminderMessage;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var claimUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier)?.Trim();
        if (string.IsNullOrWhiteSpace(claimUserId))
        {
            _loading = false;
            return;
        }

        _user = await UserManager.FindByIdAsync(claimUserId);
        if (_user is null)
        {
            _loading = false;
            return;
        }

        _userId = _user.Id;
        await Access.EnsureProfileAsync(_user);
        _profile = await Access.GetProfileAsync(_userId);
        _reminderForm.HomeAddress = _profile?.HomeAddress;
        _reminderForm.NamePronunciation = _profile?.NamePronunciation;
        _reminderForm.RemindersEnabled = _profile?.AppointmentRemindersEnabled ?? true;
        _photoUrl = await PhotoService.GetPhotoUrlForUserAsync(_userId);
        _loading = false;
    }

    private async Task SaveReminders()
    {
        if (_userId is null)
            return;

        await Access.SaveReminderSettingsAsync(
            _userId,
            _reminderForm.HomeAddress,
            _reminderForm.NamePronunciation,
            _reminderForm.RemindersEnabled);
        _profile = await Access.GetProfileAsync(_userId);
        _reminderMessage = "Saved.";
    }

    private void OpenPhotoModal() => _photoModalOpen = true;

    private Task OnPhotoModalVisibleChanged(bool visible)
    {
        _photoModalOpen = visible;
        return Task.CompletedTask;
    }

    private Task OnPhotoSaved(string? photoUrl)
    {
        _photoUrl = photoUrl;
        return InvokeAsync(StateHasChanged);
    }

    private static string GetInitials(ApplicationUser user)
    {
        var name = string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName;
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        if (name.Contains('@'))
            name = name.Split('@')[0];

        var parts = name.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        if (parts.Length == 1 && parts[0].Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[0][1])}";
        if (parts.Length == 1)
            return char.ToUpperInvariant(parts[0][0]).ToString();

        return "?";
    }

    private sealed class ReminderForm
    {
        public string? HomeAddress { get; set; }
        public string? NamePronunciation { get; set; }
        public bool RemindersEnabled { get; set; } = true;
    }
}
