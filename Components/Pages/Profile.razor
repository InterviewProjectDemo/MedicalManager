@page "/profile"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims

@inject AuthenticationStateProvider Auth
@inject UserManager<ApplicationUser> UserManager
@inject PatientAccessService Access
@inject ProfilePhotoService PhotoService
@using System.ComponentModel.DataAnnotations
@using MedicalManager.Data.Notifications

<PageTitle>Patient Profile</PageTitle>

@if (_loading)
{
    <p class="muted">Loading profile…</p>
}
else if (_user is null)
{
    <div class="alert alert-danger">Unable to load your profile.</div>
}
else
{
    <div class="page-head accent-dash">
        <div>
            <p class="eyebrow">Your account</p>
            <h1>Patient profile</h1>
            <p class="muted">Manage your photo, family contact, and health profile details.</p>
        </div>
    </div>

    <div class="profile-page-card">
        <div class="profile-page-photo-section">
            <button type="button"
                    class="profile-page-photo-wrap"
                    aria-label="Change profile photo"
                    @onclick="OpenPhotoModal">
                @if (!string.IsNullOrWhiteSpace(_photoUrl))
                {
                    <img src="@_photoUrl" alt="" class="profile-page-photo" />
                }
                else
                {
                    <span class="profile-page-photo-placeholder">@GetInitials(_user)</span>
                }
            </button>
            <div class="profile-page-photo-meta">
                <h2>@_user.DisplayName</h2>
                <p class="muted">@_user.Email</p>
                <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="OpenPhotoModal">
                    Change photo
                </button>
            </div>
        </div>

        <div class="profile-page-details-head">
            <h3 class="profile-page-section-title">Profile details</h3>
            @if (!_editingDetails)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="StartEditDetails">
                    Edit details
                </button>
            }
        </div>

        @if (_editingDetails)
        {
            <EditForm Model="_profileForm" OnValidSubmit="SaveProfileDetails">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="profile-full-name">Full name</label>
                        <InputText id="profile-full-name" class="form-control" @bind-Value="_profileForm.FullName" />
                        <ValidationMessage For="() => _profileForm.FullName" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="profile-phone">Phone</label>
                        <InputText id="profile-phone" class="form-control" @bind-Value="_profileForm.Phone" placeholder="555-0100" />
                        <ValidationMessage For="() => _profileForm.Phone" class="text-danger" />
                        <div class="form-text">Used for appointment, medication, and to-do texts, and for appointment calls.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="profile-sex">Sex</label>
                        <InputSelect id="profile-sex" class="form-select" @bind-Value="_profileForm.Sex">
                            <option value="">—</option>
                            @foreach (var option in SexOptions)
                            {
                                <option value="@option">@option</option>
                            }
                            @if (HasCustomSex)
                            {
                                <option value="@_profileForm.Sex">@_profileForm.Sex</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="profile-dob">Date of birth</label>
                        <InputDate id="profile-dob" class="form-control" @bind-Value="_profileForm.DateOfBirth" />
                        <ValidationMessage For="() => _profileForm.DateOfBirth" class="text-danger" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="profile-address">Home address</label>
                        <InputTextArea id="profile-address" class="form-control" rows="2" @bind-Value="_profileForm.HomeAddress" placeholder="123 Main Street, Austin, TX" />
                        <ValidationMessage For="() => _profileForm.HomeAddress" class="text-danger" />
                        <div class="form-text">Also used to estimate the drive to an appointment.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="profile-notes">Notes</label>
                        <InputTextArea id="profile-notes" class="form-control" rows="2" @bind-Value="_profileForm.Notes" />
                        <ValidationMessage For="() => _profileForm.Notes" class="text-danger" />
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_profileError))
                {
                    <div class="alert alert-danger mt-3 mb-0">@_profileError</div>
                }
                <div class="form-actions">
                    <button type="submit" class="btn btn-purple" disabled="@_savingDetails">
                        @(_savingDetails ? "Saving…" : "Save details")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEditDetails" disabled="@_savingDetails">
                        Cancel
                    </button>
                </div>
            </EditForm>
        }
        else
        {
            <dl class="profile-page-details">
                <div>
                    <dt>Full name</dt>
                    <dd>@(string.IsNullOrWhiteSpace(_user.FullName) ? "—" : _user.FullName)</dd>
                </div>
                <div>
                    <dt>Email</dt>
                    <dd>@(_user.Email ?? "—")</dd>
                </div>
                <div>
                    <dt>Phone</dt>
                    <dd>@(DisplayPhone)</dd>
                </div>
                <div>
                    <dt>Home address</dt>
                    <dd>@(string.IsNullOrWhiteSpace(_profile?.HomeAddress) ? "—" : _profile.HomeAddress)</dd>
                </div>
                <div>
                    <dt>Date of birth</dt>
                    <dd>@(_profile?.DateOfBirth?.ToString("MMMM d, yyyy") ?? "—")</dd>
                </div>
                <div>
                    <dt>Sex</dt>
                    <dd>@(_profile?.Sex ?? "—")</dd>
                </div>
                <div>
                    <dt>Notes</dt>
                    <dd>@(string.IsNullOrWhiteSpace(_profile?.Notes) ? "—" : _profile.Notes)</dd>
                </div>
            </dl>
            @if (!string.IsNullOrWhiteSpace(_profileMessage))
            {
                <p class="muted mb-3">@_profileMessage</p>
            }
        }

        <p class="profile-page-account-hint">
            <a href="Account/Manage">Account settings</a> — update email and password.
        </p>
    </div>

    <div class="profile-page-card">
        <div class="profile-page-details-head">
            <div>
                <h2 class="reminder-settings-title">Family contact</h2>
                <p class="muted mb-0">The person reached from the Family button. Name and phone are required. A photo is optional.</p>
            </div>
            @if (!_editingFamily)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="StartEditFamily">
                    @(_profile?.FamilyContactName is null ? "Add family contact" : "Edit")
                </button>
            }
        </div>

        @if (_editingFamily)
        {
            <EditForm Model="_familyForm" OnValidSubmit="SaveFamilyContact">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="family-contact-edit">
                    <div class="family-contact-photo">
                        @if (!string.IsNullOrWhiteSpace(FamilyPhotoPreview))
                        {
                            <img src="@FamilyPhotoPreview" alt="" />
                        }
                        else
                        {
                            <span>@FamilyInitials</span>
                        }
                    </div>
                    <div class="row g-3 flex-grow-1">
                        <div class="col-md-6">
                            <label class="form-label" for="family-name">Name</label>
                            <InputText id="family-name" class="form-control" @bind-Value="_familyForm.Name" />
                            <ValidationMessage For="() => _familyForm.Name" class="text-danger" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="family-phone">Phone</label>
                            <InputText id="family-phone" class="form-control" @bind-Value="_familyForm.Phone" placeholder="555-0100" />
                            <ValidationMessage For="() => _familyForm.Phone" class="text-danger" />
                        </div>
                        <div class="col-12">
                            <label class="btn btn-outline-secondary btn-sm family-photo-file-btn">
                                Choose photo
                                <InputFile OnChange="OnFamilyPhotoSelected" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" class="profile-photo-file-input" />
                            </label>
                            @if (HasFamilyPhoto)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="MarkFamilyPhotoCleared">
                                    Remove photo
                                </button>
                            }
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_familyError))
                {
                    <div class="alert alert-danger mt-3 mb-0">@_familyError</div>
                }
                <div class="form-actions">
                    <button type="submit" class="btn btn-purple" disabled="@_savingFamily">
                        @(_savingFamily ? "Saving…" : "Save family contact")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEditFamily" disabled="@_savingFamily">
                        Cancel
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_profile?.FamilyContactName))
                    {
                        <button type="button" class="btn btn-outline-danger ms-auto" @onclick="RemoveFamilyContact" disabled="@_savingFamily">
                            Remove family contact
                        </button>
                    }
                </div>
            </EditForm>
        }
        else if (string.IsNullOrWhiteSpace(_profile?.FamilyContactName))
        {
            <p class="muted mb-0">No family contact yet. Add a name and phone so the Family button can reach them.</p>
        }
        else
        {
            <div class="family-contact-view">
                <div class="family-contact-photo">
                    @if (!string.IsNullOrWhiteSpace(_familyPhotoUrl))
                    {
                        <img src="@_familyPhotoUrl" alt="" />
                    }
                    else
                    {
                        <span>@FamilyInitials</span>
                    }
                </div>
                <dl class="profile-page-details">
                    <div>
                        <dt>Name</dt>
                        <dd>@_profile.FamilyContactName</dd>
                    </div>
                    <div>
                        <dt>Phone</dt>
                        <dd>@_profile.FamilyContactPhone</dd>
                    </div>
                    <div>
                        <dt>Photo</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_familyPhotoUrl) ? "None" : "Added")</dd>
                    </div>
                </dl>
            </div>
            @if (!string.IsNullOrWhiteSpace(_familyMessage))
            {
                <p class="muted mb-0">@_familyMessage</p>
            }
        }
    </div>

    <div class="profile-page-card">
        <h2 class="reminder-settings-title">Notification services</h2>
        <p class="muted">
            Calls come from Medical Manager at (320) 350-3177. Appointment reminders also send a text. Medication and to-do reminders are phone calls.
            One day before a visit or a to-do, you get a reminder. One hour before, you get another.
            Medicine calls arrive when that dose window opens.
        </p>
        @if (string.IsNullOrWhiteSpace(DisplayPhone) || DisplayPhone == "—")
        {
            <div class="alert alert-warning">Add a phone number in your profile details so the reminders can reach you.</div>
        }
        <EditForm Model="_reminderForm" OnValidSubmit="SaveReminders" class="mt-3">
            <div class="mb-3">
                <label class="form-label" for="home-address">Home address</label>
                <InputTextArea id="home-address" class="form-control" rows="2" @bind-Value="_reminderForm.HomeAddress" placeholder="123 Main Street, Austin, TX" />
                <div class="form-text">Used to estimate the drive to the appointment. The address stays on your profile.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="name-pronunciation">How should we say your name?</label>
                <InputText id="name-pronunciation" class="form-control" @bind-Value="_reminderForm.NamePronunciation" placeholder="nah-VEEN SHAR-mah" />
                <div class="form-text">
                    Leave this blank to use the spelling @_user.DisplayName.
                    Calls will say: @NameSpeaker.Preview(_user.FullName, _reminderForm.NamePronunciation)
                </div>
            </div>
            <div class="form-check mb-2">
                <InputCheckbox id="appointment-reminders" class="form-check-input" @bind-Value="_reminderForm.AppointmentRemindersEnabled" />
                <label class="form-check-label" for="appointment-reminders">Appointment reminders. A call and a text one day before, and a call one hour before.</label>
            </div>
            <div class="form-check mb-2">
                <InputCheckbox id="medication-reminders" class="form-check-input" @bind-Value="_reminderForm.MedicationRemindersEnabled" />
                <label class="form-check-label" for="medication-reminders">Medication reminders. A call when a morning, lunch, evening, or bedtime dose is due.</label>
            </div>
            <div class="form-check mb-3">
                <InputCheckbox id="todo-reminders" class="form-check-input" @bind-Value="_reminderForm.ToDoRemindersEnabled" />
                <label class="form-check-label" for="todo-reminders">To-do reminders. A call one day before and one hour before the finish time.</label>
            </div>
            <button type="submit" class="btn btn-purple">Save reminder settings</button>
            @if (!string.IsNullOrWhiteSpace(_reminderMessage))
            {
                <span class="ms-2 muted">@_reminderMessage</span>
            }
        </EditForm>
    </div>

    <ProfilePhotoModal Visible="_photoModalOpen"
                       VisibleChanged="OnPhotoModalVisibleChanged"
                       PhotoSaved="OnPhotoSaved" />
}

@code {
    private static readonly string[] SexOptions = ["Female", "Male", "Intersex", "Prefer not to say"];

    private bool _loading = true;
    private bool _editingDetails;
    private bool _savingDetails;
    private string? _userId;
    private string? _photoUrl;
    private bool _photoModalOpen;
    private ApplicationUser? _user;
    private PatientProfile? _profile;
    private readonly ProfileForm _profileForm = new();
    private readonly FamilyForm _familyForm = new();
    private readonly ReminderForm _reminderForm = new();
    private string? _profileMessage;
    private string? _profileError;
    private string? _reminderMessage;
    private bool _editingFamily;
    private bool _savingFamily;
    private bool _clearFamilyPhoto;
    private string? _familyMessage;
    private string? _familyError;
    private string? _familyPhotoUrl;
    private string? _familyPreviewUrl;
    private byte[]? _familyPhotoBytes;
    private string? _familyPhotoName;
    private string? _familyPhotoType;

    private string DisplayPhone =>
        string.IsNullOrWhiteSpace(_profile?.Phone)
            ? (string.IsNullOrWhiteSpace(_user?.PhoneNumber) ? "—" : _user.PhoneNumber)
            : _profile.Phone;

    private string? FamilyPhotoPreview =>
        _clearFamilyPhoto ? null : (_familyPreviewUrl ?? _familyPhotoUrl);

    private bool HasFamilyPhoto =>
        !_clearFamilyPhoto && (!string.IsNullOrWhiteSpace(_familyPreviewUrl) || !string.IsNullOrWhiteSpace(_familyPhotoUrl));

    private string FamilyInitials => InitialsFrom(_editingFamily ? _familyForm.Name : _profile?.FamilyContactName);

    private bool HasCustomSex =>
        !string.IsNullOrWhiteSpace(_profileForm.Sex)
        && !SexOptions.Contains(_profileForm.Sex, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var claimUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier)?.Trim();
        if (string.IsNullOrWhiteSpace(claimUserId))
        {
            _loading = false;
            return;
        }

        _user = await UserManager.FindByIdAsync(claimUserId);
        if (_user is null)
        {
            _loading = false;
            return;
        }

        _userId = _user.Id;
        await Access.EnsureProfileAsync(_user);
        _profile = await Access.GetProfileAsync(_userId);
        FillProfileForm();
        _reminderForm.HomeAddress = _profile?.HomeAddress;
        _reminderForm.NamePronunciation = _profile?.NamePronunciation;
        _reminderForm.AppointmentRemindersEnabled = _profile?.AppointmentRemindersEnabled ?? true;
        _reminderForm.MedicationRemindersEnabled = _profile?.MedicationRemindersEnabled ?? true;
        _reminderForm.ToDoRemindersEnabled = _profile?.ToDoRemindersEnabled ?? true;
        _photoUrl = await PhotoService.GetPhotoUrlForUserAsync(_userId);
        _familyPhotoUrl = PhotoService.GetFamilyPhotoUrl(_userId, _profile?.FamilyContactPhotoUpdatedAt);
        _loading = false;
    }

    private void StartEditDetails()
    {
        FillProfileForm();
        _profileError = null;
        _profileMessage = null;
        _editingDetails = true;
    }

    private void CancelEditDetails()
    {
        FillProfileForm();
        _profileError = null;
        _editingDetails = false;
    }

    private async Task SaveProfileDetails()
    {
        if (_userId is null || _savingDetails)
            return;

        if (_profileForm.DateOfBirth is DateOnly dob && dob > DateOnly.FromDateTime(DateTime.Today))
        {
            _profileError = "Date of birth cannot be in the future.";
            return;
        }

        _savingDetails = true;
        _profileError = null;
        try
        {
            await Access.SaveProfileDetailsAsync(
                _userId,
                _profileForm.FullName,
                _profileForm.Phone,
                _profileForm.Sex,
                _profileForm.HomeAddress,
                _profileForm.DateOfBirth,
                _profileForm.Notes);

            if (_user is not null)
            {
                var phone = string.IsNullOrWhiteSpace(_profileForm.Phone) ? null : _profileForm.Phone.Trim();
                if (!string.Equals(_user.PhoneNumber, phone, StringComparison.Ordinal))
                {
                    _user.PhoneNumber = phone;
                    _user.PhoneNumberConfirmed = false;
                }

                _user.FullName = _profileForm.FullName.Trim();
            }

            _profile = await Access.GetProfileAsync(_userId);
            _reminderForm.HomeAddress = _profile?.HomeAddress;
            FillProfileForm();
            _editingDetails = false;
            _profileMessage = "Profile details saved.";
        }
        catch (InvalidOperationException ex)
        {
            _profileError = ex.Message;
        }
        finally
        {
            _savingDetails = false;
        }
    }

    private void FillProfileForm()
    {
        _profileForm.FullName = _user?.FullName ?? "";
        _profileForm.Phone = _profile?.Phone ?? _user?.PhoneNumber;
        _profileForm.Sex = _profile?.Sex ?? "";
        _profileForm.HomeAddress = _profile?.HomeAddress;
        _profileForm.DateOfBirth = _profile?.DateOfBirth;
        _profileForm.Notes = _profile?.Notes;
    }

    private void StartEditFamily()
    {
        _familyForm.Name = _profile?.FamilyContactName ?? "";
        _familyForm.Phone = _profile?.FamilyContactPhone;
        _familyPreviewUrl = null;
        _familyPhotoBytes = null;
        _familyPhotoName = null;
        _familyPhotoType = null;
        _clearFamilyPhoto = false;
        _familyError = null;
        _familyMessage = null;
        _editingFamily = true;
    }

    private void CancelEditFamily()
    {
        _familyError = null;
        _familyPreviewUrl = null;
        _familyPhotoBytes = null;
        _clearFamilyPhoto = false;
        _editingFamily = false;
    }

    private async Task OnFamilyPhotoSelected(InputFileChangeEventArgs e)
    {
        _familyError = null;
        var file = e.File;
        if (file.Size > ProfilePhotoService.MaxBytes)
        {
            _familyError = "Image must be 5 MB or smaller.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(ProfilePhotoService.MaxBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _familyPhotoBytes = memory.ToArray();
            _familyPhotoName = file.Name;
            _familyPhotoType = file.ContentType;
            _clearFamilyPhoto = false;
            var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            _familyPreviewUrl = $"data:{contentType};base64,{Convert.ToBase64String(_familyPhotoBytes)}";
        }
        catch (Exception ex)
        {
            _familyError = ex.Message;
        }
    }

    private void MarkFamilyPhotoCleared()
    {
        _clearFamilyPhoto = true;
        _familyPreviewUrl = null;
        _familyPhotoBytes = null;
        _familyPhotoName = null;
        _familyPhotoType = null;
    }

    private async Task SaveFamilyContact()
    {
        if (_userId is null || _savingFamily)
            return;

        _savingFamily = true;
        _familyError = null;
        try
        {
            await Access.SaveFamilyContactAsync(_userId, _familyForm.Name, _familyForm.Phone);

            if (_clearFamilyPhoto)
            {
                await PhotoService.DeleteFamilyPhotoAsync(_userId);
            }
            else if (_familyPhotoBytes is not null)
            {
                var saved = await PhotoService.SaveFamilyPhotoAsync(
                    _userId,
                    _familyPhotoBytes,
                    _familyPhotoType,
                    _familyPhotoName);
                if (!saved.Success)
                {
                    _familyError = saved.Error ?? "The photo could not be saved.";
                    _profile = await Access.GetProfileAsync(_userId);
                    return;
                }
            }

            _profile = await Access.GetProfileAsync(_userId);
            _familyPhotoUrl = PhotoService.GetFamilyPhotoUrl(_userId, _profile?.FamilyContactPhotoUpdatedAt);
            _familyPreviewUrl = null;
            _familyPhotoBytes = null;
            _clearFamilyPhoto = false;
            _editingFamily = false;
            _familyMessage = "Family contact saved.";
        }
        catch (InvalidOperationException ex)
        {
            _familyError = ex.Message;
        }
        finally
        {
            _savingFamily = false;
        }
    }

    private async Task RemoveFamilyContact()
    {
        if (_userId is null || _savingFamily)
            return;

        _savingFamily = true;
        _familyError = null;
        try
        {
            await Access.ClearFamilyContactAsync(_userId);
            _profile = await Access.GetProfileAsync(_userId);
            _familyPhotoUrl = null;
            _familyPreviewUrl = null;
            _familyPhotoBytes = null;
            _clearFamilyPhoto = false;
            _familyForm.Name = "";
            _familyForm.Phone = null;
            _editingFamily = false;
            _familyMessage = "Family contact removed.";
        }
        catch (InvalidOperationException ex)
        {
            _familyError = ex.Message;
        }
        finally
        {
            _savingFamily = false;
        }
    }

    private async Task SaveReminders()
    {
        if (_userId is null)
            return;

        await Access.SaveReminderSettingsAsync(
            _userId,
            _reminderForm.HomeAddress,
            _reminderForm.NamePronunciation,
            _reminderForm.AppointmentRemindersEnabled,
            _reminderForm.MedicationRemindersEnabled,
            _reminderForm.ToDoRemindersEnabled);
        _profile = await Access.GetProfileAsync(_userId);
        if (_editingDetails)
            _profileForm.HomeAddress = _profile?.HomeAddress;
        _reminderMessage = "Saved.";
    }

    private void OpenPhotoModal() => _photoModalOpen = true;

    private Task OnPhotoModalVisibleChanged(bool visible)
    {
        _photoModalOpen = visible;
        return Task.CompletedTask;
    }

    private Task OnPhotoSaved(string? photoUrl)
    {
        _photoUrl = photoUrl;
        return InvokeAsync(StateHasChanged);
    }

    private static string GetInitials(ApplicationUser user)
    {
        var name = string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName;
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        if (name.Contains('@'))
            name = name.Split('@')[0];

        var parts = name.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        if (parts.Length == 1 && parts[0].Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[0][1])}";
        if (parts.Length == 1)
            return char.ToUpperInvariant(parts[0][0]).ToString();

        return "?";
    }

    private static string InitialsFrom(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
        if (parts[0].Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[0][1])}";
        return char.ToUpperInvariant(parts[0][0]).ToString();
    }

    private sealed class ProfileForm
    {
        [Required(ErrorMessage = "Full name is required.")]
        [MaxLength(200)]
        public string FullName { get; set; } = "";

        [Phone(ErrorMessage = "Enter a valid phone number.")]
        [MaxLength(40)]
        public string? Phone { get; set; }

        [MaxLength(40)]
        public string? Sex { get; set; }

        [MaxLength(300)]
        public string? HomeAddress { get; set; }

        public DateOnly? DateOfBirth { get; set; }

        [MaxLength(400)]
        public string? Notes { get; set; }
    }

    private sealed class FamilyForm
    {
        [Required(ErrorMessage = "Family contact name is required.")]
        [MaxLength(200)]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Family contact phone is required.")]
        [Phone(ErrorMessage = "Enter a valid phone number.")]
        [MaxLength(40)]
        public string? Phone { get; set; }
    }

    private sealed class ReminderForm
    {
        public string? HomeAddress { get; set; }
        public string? NamePronunciation { get; set; }
        public bool AppointmentRemindersEnabled { get; set; } = true;
        public bool MedicationRemindersEnabled { get; set; } = true;
