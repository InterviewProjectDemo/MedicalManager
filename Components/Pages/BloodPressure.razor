@page "/blood-pressure"
@attribute [Authorize]
@inject HealthRecordService Records
@inject PatientAccessService Access
@inject AuthenticationStateProvider Auth

<PageTitle>Blood pressure</PageTitle>
<RequirePatient Scope="scope" />

@if (scope?.Patient is not null)
{
    <PatientBanner Scope="scope" />
    <div class="page-head accent-bp">
        <div>
            <p class="eyebrow">Vitals</p>
            <h1>Blood pressure</h1>
            <p class="muted">Add or update readings. Green is in range, amber is elevated, red is high.</p>
        </div>
        <a class="btn btn-primary" href="@Link("blood-pressure/edit")">Add reading</a>
    </div>

    <div class="table-card">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Reading</th>
                    <th>Pulse</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    var tag = VitalStatus.ForBloodPressure(item.Systolic, item.Diastolic);
                    <tr>
                        <td>@item.RecordedAt.ToString("g")</td>
                        <td>@item.Systolic/@item.Diastolic mmHg</td>
                        <td>@(item.Pulse?.ToString() ?? "—")</td>
                        <td><StatusPill Label="@tag.Label" CssClass="@tag.CssClass" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="@Link($"blood-pressure/edit/{item.Id}")">Update</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (items.Count == 0)
        {
            <p class="muted p-3">No blood pressure readings yet.</p>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? PatientUserId { get; set; }
    private PatientScope? scope;
    private List<BloodPressureReading> items = [];

    protected override async Task OnParametersSetAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        scope = await Access.ResolveAsync(state.User, PatientUserId);
        if (scope.PatientId is string id)
        {
            items = await Records.GetBloodPressureAsync(id);
        }
    }

    private string Link(string path) => CareLinks.To(path, PatientUserId);
}
