@page "/sugar"
@attribute [Authorize]
@inject HealthRecordService Records
@inject PatientAccessService Access
@inject AuthenticationStateProvider Auth

<PageTitle>Sugar readings</PageTitle>
<RequirePatient Scope="scope" />

@if (scope?.Patient is not null)
{
    <PatientBanner Scope="scope" />
    <div class="page-head accent-sugar">
        <div>
            <p class="eyebrow">Vitals</p>
            <h1>Sugar readings</h1>
            <p class="muted">Track fasting, after-meal, and random glucose values.</p>
        </div>
        <a class="btn btn-warning text-white" href="@Link("sugar/edit")">Add reading</a>
    </div>

    <div class="table-card">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th aria-sort="@AriaSort(SugarSort.When)">
                        <button type="button" class="sort-th-btn" @onclick="() => SortBy(SugarSort.When)">
                            When <span class="sort-indicator" aria-hidden="true">@SortMark(SugarSort.When)</span>
                        </button>
                    </th>
                    <th aria-sort="@AriaSort(SugarSort.Value)">
                        <button type="button" class="sort-th-btn" @onclick="() => SortBy(SugarSort.Value)">
                            Value <span class="sort-indicator" aria-hidden="true">@SortMark(SugarSort.Value)</span>
                        </button>
                    </th>
                    <th aria-sort="@AriaSort(SugarSort.Type)">
                        <button type="button" class="sort-th-btn" @onclick="() => SortBy(SugarSort.Type)">
                            Type <span class="sort-indicator" aria-hidden="true">@SortMark(SugarSort.Type)</span>
                        </button>
                    </th>
                    <th aria-sort="@AriaSort(SugarSort.Status)">
                        <button type="button" class="sort-th-btn" @onclick="() => SortBy(SugarSort.Status)">
                            Status <span class="sort-indicator" aria-hidden="true">@SortMark(SugarSort.Status)</span>
                        </button>
                    </th>
                    <th></th>
                </tr>
                <tr class="column-filter-row" @key="_filterVersion">
                    <th>
                        <div class="column-filter-dates">
                            <label>
                                <span class="visually-hidden">From date</span>
                                <input type="date"
                                       class="form-control form-control-sm"
                                       value="@FormatDate(_whenFrom)"
                                       @onchange="e => _whenFrom = ParseFilterDate(e.Value)" />
                            </label>
                            <label>
                                <span class="visually-hidden">To date</span>
                                <input type="date"
                                       class="form-control form-control-sm"
                                       value="@FormatDate(_whenTo)"
                                       @onchange="e => _whenTo = ParseFilterDate(e.Value)" />
                            </label>
                        </div>
                    </th>
                    <th>
                        <div class="column-filter-range">
                            <label>
                                <span class="visually-hidden">Minimum glucose</span>
                                <input type="number"
                                       class="form-control form-control-sm"
                                       placeholder="Min"
                                       min="0"
                                       step="1"
                                       value="@FormatDecimal(_valueMin)"
                                       @oninput="e => _valueMin = ParseFilterDecimal(e.Value)" />
                            </label>
                            <label>
                                <span class="visually-hidden">Maximum glucose</span>
                                <input type="number"
                                       class="form-control form-control-sm"
                                       placeholder="Max"
                                       min="0"
                                       step="1"
                                       value="@FormatDecimal(_valueMax)"
                                       @oninput="e => _valueMax = ParseFilterDecimal(e.Value)" />
                            </label>
                        </div>
                    </th>
                    <th>
                        <label class="column-filter-select">
                            <span class="visually-hidden">Filter by type</span>
                            <select class="form-select form-select-sm"
                                    value="@_kindFilter"
                                    @onchange="OnKindFilterChanged">
                                <option value="">All types</option>
                                @foreach (var kind in Enum.GetValues<SugarKind>())
                                {
                                    <option value="@kind">@kind</option>
                                }
                            </select>
                        </label>
                    </th>
                    <th>
                        <label class="column-filter-select">
                            <span class="visually-hidden">Filter by status</span>
                            <select class="form-select form-select-sm"
                                    value="@_statusFilter"
                                    @onchange="OnStatusFilterChanged">
                                <option value="">All statuses</option>
                                @foreach (var status in StatusOptions)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </label>
                    </th>
                    <th>
                        @if (HasFilters)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear</button>
                        }
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in VisibleItems)
                {
                    var tag = VitalStatus.ForSugar(item.Value, item.Kind);
                    <tr>
                        <td data-label="When">@item.RecordedAt.ToString("g")</td>
                        <td data-label="Value">@item.Value.ToString("0.#") @item.Unit</td>
                        <td data-label="Type">@item.Kind</td>
                        <td data-label="Status"><StatusPill Label="@tag.Label" CssClass="@tag.CssClass" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-warning" href="@Link($"sugar/edit/{item.Id}")">Update</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (items.Count == 0)
        {
            <p class="muted p-3">No sugar readings yet.</p>
        }
        else if (VisibleItems.Count == 0)
        {
            <p class="muted p-3">No readings match the current filters.</p>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? PatientUserId { get; set; }
    private PatientScope? scope;
    private List<SugarReading> items = [];
    private SugarSort _sort = SugarSort.When;
    private bool _sortAsc;

    private DateOnly? _whenFrom;
    private DateOnly? _whenTo;
    private decimal? _valueMin;
    private decimal? _valueMax;
    private string _kindFilter = "";
    private string _statusFilter = "";

    private int _filterVersion;
    private int _appliedFilterVersion;

    private static readonly string[] StatusOptions = ["Low", "Normal", "Elevated", "High"];

    private enum SugarSort
    {
        When,
        Value,
        Type,
        Status
    }

    private bool HasFilters =>
        _whenFrom is not null
        || _whenTo is not null
        || _valueMin is not null
        || _valueMax is not null
        || !string.IsNullOrEmpty(_kindFilter)
        || !string.IsNullOrEmpty(_statusFilter);

    private List<SugarReading> VisibleItems => Sort(Filter(items)).ToList();

    private IEnumerable<SugarReading> Filter(IEnumerable<SugarReading> source)
    {
        var query = source;
        if (_whenFrom is DateOnly from)
        {
            query = query.Where(x => DateOnly.FromDateTime(x.RecordedAt) >= from);
        }

        if (_whenTo is DateOnly to)
        {
            query = query.Where(x => DateOnly.FromDateTime(x.RecordedAt) <= to);
        }

        if (_valueMin is decimal valueMin)
        {
            query = query.Where(x => x.Value >= valueMin);
        }

        if (_valueMax is decimal valueMax)
        {
            query = query.Where(x => x.Value <= valueMax);
        }

        if (Enum.TryParse<SugarKind>(_kindFilter, out var kind))
        {
            query = query.Where(x => x.Kind == kind);
        }

        if (!string.IsNullOrEmpty(_statusFilter))
        {
            query = query.Where(x => VitalStatus.ForSugar(x.Value, x.Kind).Label == _statusFilter);
        }

        return query;
    }

    private IEnumerable<SugarReading> Sort(IEnumerable<SugarReading> source) => _sort switch
    {
        SugarSort.Value => _sortAsc
            ? source.OrderBy(x => x.Value)
            : source.OrderByDescending(x => x.Value),
        SugarSort.Type => _sortAsc
            ? source.OrderBy(x => x.Kind).ThenBy(x => x.RecordedAt)
            : source.OrderByDescending(x => x.Kind).ThenByDescending(x => x.RecordedAt),
        SugarSort.Status => _sortAsc
            ? source.OrderBy(StatusRank)
            : source.OrderByDescending(StatusRank),
        _ => _sortAsc
            ? source.OrderBy(x => x.RecordedAt)
            : source.OrderByDescending(x => x.RecordedAt)
    };

    private void SortBy(SugarSort column)
    {
        if (_sort == column)
        {
            _sortAsc = !_sortAsc;
            return;
        }

        _sort = column;
        _sortAsc = column != SugarSort.When;
    }

    private void ClearFilters()
    {
        _whenFrom = null;
        _whenTo = null;
        _valueMin = null;
        _valueMax = null;
        _kindFilter = "";
        _statusFilter = "";
        _filterVersion++;
    }

    private decimal? ParseFilterDecimal(object? value) =>
        _filterVersion != _appliedFilterVersion ? null : ParseDecimal(value);

    private DateOnly? ParseFilterDate(object? value) =>
        _filterVersion != _appliedFilterVersion ? null : ParseDate(value);

    private void OnKindFilterChanged(ChangeEventArgs e)
    {
        if (_filterVersion != _appliedFilterVersion) return;
        _kindFilter = e.Value?.ToString() ?? "";
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        if (_filterVersion != _appliedFilterVersion) return;
        _statusFilter = e.Value?.ToString() ?? "";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _appliedFilterVersion = _filterVersion;
    }

    private string AriaSort(SugarSort column) =>
        _sort != column ? "none" : _sortAsc ? "ascending" : "descending";

    private string SortMark(SugarSort column)
    {
        if (_sort != column)
        {
            return "↕";
        }

        return _sortAsc ? "↑" : "↓";
    }

    private static int StatusRank(SugarReading item)
    {
        var tag = VitalStatus.ForSugar(item.Value, item.Kind);
        return tag.Label switch
        {
            "Elevated" => 1,
            "High" => 2,
            "Low" => 3,
            _ => 0
        };
    }

    private static string FormatDate(DateOnly? date) =>
        date?.ToString("yyyy-MM-dd") ?? "";

    private static string FormatDecimal(decimal? value) =>
        value?.ToString("0.#") ?? "";

    private static DateOnly? ParseDate(object? value) =>
        DateOnly.TryParse(value?.ToString(), out var date) ? date : null;

    private static decimal? ParseDecimal(object? value) =>
        decimal.TryParse(value?.ToString(), out var number) ? number : null;

    protected override async Task OnParametersSetAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        scope = await Access.ResolveAsync(state.User, PatientUserId);
        if (scope.PatientId is string id)
        {
            items = await Records.GetSugarAsync(id);
        }
    }

    private string Link(string path) => CareLinks.To(path, PatientUserId);
}
