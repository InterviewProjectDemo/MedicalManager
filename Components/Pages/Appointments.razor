@page "/appointments"
@attribute [Authorize]
@inject HealthRecordService Records
@inject PatientAccessService Access
@inject AuthenticationStateProvider Auth

<PageTitle>Appointments</PageTitle>
<RequirePatient Scope="scope" />

@if (scope?.Patient is not null)
{
    <PatientBanner Scope="scope" />
    <div class="page-head accent-appt">
        <div>
            <p class="eyebrow">Schedule</p>
            <h1>Appointments</h1>
            <p class="muted">Add or update visits here. Past visits that were not marked Completed or Cancelled show as Missed.</p>
        </div>
        <a class="btn btn-purple" href="@Link("appointments/edit")">Add appointment</a>
    </div>

    <div class="table-card">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Visit</th>
                    <th>With whom</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    var css = AppointmentRules.StatusCss(item.Status);
                    <tr class="@(item.Status == AppointmentStatus.Missed ? "appt-row-missed" : null)">
                        <td>
                            @item.StartsAt.ToString("g")
                            @if (item.EndsAt is DateTime ends)
                            {
                                <div class="muted">until @ends.ToString("t")</div>
                            }
                        </td>
                        <td>
                            <strong>@item.Title</strong>
                            <div class="muted">@item.Location</div>
                        </td>
                        <td>@item.ProviderName</td>
                        <td><StatusPill Label="@item.Status.ToString()" CssClass="@css" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@Link($"appointments/edit/{item.Id}")">Update</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (items.Count == 0)
        {
            <p class="muted p-3">No appointments yet.</p>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? PatientUserId { get; set; }
    private PatientScope? scope;
    private List<Appointment> items = [];

    protected override async Task OnParametersSetAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        scope = await Access.ResolveAsync(state.User, PatientUserId);
        if (scope.PatientId is string id)
        {
            items = await Records.GetAppointmentsAsync(id);
        }
    }

    private string Link(string path) => CareLinks.To(path, PatientUserId);
}
