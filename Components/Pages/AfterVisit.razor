@page "/after-visit"
@attribute [Authorize]
@implements IDisposable
@inject VirtualVisitService Visits
@inject ChartAccessService ChartAccess
@inject AuthenticationStateProvider Auth
@inject GrantedPatientSelection Selection

<PageTitle>After-visit summary</PageTitle>

<div class="page-head accent-doctor">
    <div>
        <p class="eyebrow">Virtual visit</p>
        <h1>After-visit summary</h1>
        @if (_isDoctor)
        {
            <p class="muted">Write what the patient should know after this visit. The summary is editable after you pick that patient on the Patients page.</p>
        }
        else
        {
            <p class="muted">Read the summaries your doctors wrote. Filter by date, sort, and step through each visit.</p>
        }
    </div>
</div>

@if (_isDoctor && string.IsNullOrWhiteSpace(_patientId))
{
    <div class="table-card p-3">
        <p>Pick a patient on the Patients page. The radio button there chooses who this summary is for.</p>
        <p class="mb-0"><a href="patients">Patients</a></p>
    </div>
}
else if (_isDoctor && !_hasGrant)
{
    <div class="table-card p-3">
        <p><strong>@_patientName</strong> is selected. The summary opens for editing after that patient approves access.</p>
        <p class="mb-0"><a href="patients">Request access</a></p>
    </div>
}
else
{
    @if (_isDoctor)
    {
        <p class="muted">Editing the summary for <strong>@_patientName</strong>.</p>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" class="form-card mb-3">
            <label class="form-label" for="summary-body">@(_editingId is null ? "New summary" : "Edit this summary")</label>
            <InputTextArea id="summary-body" class="form-control mb-3" rows="5" @bind-Value="_form.Body" />
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger py-2" role="alert">@_error</div>
            }
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-teal" disabled="@_saving">@(_editingId is null ? "Save summary" : "Save changes")</button>
                @if (_editingId is not null)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Write a new summary</button>
                }
            </div>
        </EditForm>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2" role="alert">@_error</div>
    }

    <div class="table-card p-3">
        <AfterVisitBrowser Items="_items" CanEdit="_isDoctor" EditRequested="BeginEdit" />
    </div>
}

@code {
    private readonly TextForm _form = new();
    private IReadOnlyList<AfterVisitSummary> _items = [];
    private string? _error;
    private bool _saving;
    private bool _isDoctor;
    private bool _hasGrant;
    private string? _userId;
    private string? _patientId;
    private string? _patientName;
    private string? _loadedPatientId;
    private int? _editingId;

    protected override void OnInitialized() => Selection.Changed += HandleSelection;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void HandleSelection() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Selection.Changed -= HandleSelection;

    private async Task LoadAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _isDoctor = state.User.IsInRole(AppRoles.Doctor);
        _userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _error = null;

        if (_isDoctor)
        {
            var nextPatient = Selection.PatientUserId;
            if (!string.Equals(_loadedPatientId, nextPatient, StringComparison.Ordinal))
            {
                _form.Body = "";
                _editingId = null;
                _loadedPatientId = nextPatient;
            }

            _patientId = nextPatient;
            _patientName = Selection.PatientName;
            _hasGrant = false;
            _items = [];
            if (string.IsNullOrWhiteSpace(_userId) || string.IsNullOrWhiteSpace(_patientId))
                return;

            var grant = await ChartAccess.GetActiveGrantAsync(_userId, _patientId);
            _hasGrant = grant is not null;
            if (!_hasGrant)
                return;

            _items = await Visits.ListSummariesAsync(state.User, _patientId);
            return;
        }

        if (string.IsNullOrWhiteSpace(_userId))
            return;

        _patientId = _userId;
        _items = await Visits.ListSummariesAsync(state.User, _userId);
    }

    private void BeginEdit(AfterVisitSummary item)
    {
        _editingId = item.Id;
        _form.Body = item.Body;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form.Body = "";
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_userId) || string.IsNullOrWhiteSpace(_patientId))
            return;

        _saving = true;
        _error = null;
        try
        {
            if (_editingId is int summaryId)
                await Visits.UpdateSummaryAsync(_userId, _patientId, summaryId, _form.Body);
            else
                await Visits.AddSummaryAsync(_userId, _patientId, _form.Body);

            _form.Body = "";
            _editingId = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class TextForm
    {
        public string Body { get; set; } = "";
    }
}
