@page "/sugar/edit"
@page "/sugar/edit/{Id:int}"
@attribute [Authorize]
@inject HealthRecordService Records
@inject PatientAccessService Access
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Add" : "Update") sugar reading</PageTitle>
<RequirePatient Scope="scope" />

@if (model is not null)
{
    <PatientBanner Scope="scope" />
    <div class="page-head accent-sugar">
        <div>
            <p class="eyebrow">Sugar</p>
            <h1>@(Id is null ? "Add reading" : "Update reading")</h1>
        </div>
    </div>

    <EditForm Model="model" OnValidSubmit="Save" class="form-card">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Value (mg/dL)</label>
                <InputNumber class="form-control" @bind-Value="model.Value" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Type</label>
                <InputSelect class="form-select" @bind-Value="model.Kind">
                    @foreach (var kind in Enum.GetValues<SugarKind>())
                    {
                        <option value="@kind">@kind</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label class="form-label">Recorded at</label>
                <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="model.RecordedAt" />
            </div>
            <div class="col-12">
                <label class="form-label">Notes</label>
                <InputText class="form-control" @bind-Value="model.Notes" />
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-warning text-white">Save</button>
            <a class="btn btn-outline-secondary" href="@Back">Cancel</a>
            @if (Id is not null)
            {
                <button type="button" class="btn btn-outline-danger ms-auto" @onclick="Delete">Delete</button>
            }
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] public string? PatientUserId { get; set; }
    private PatientScope? scope;
    private SugarReading? model;
    private string Back => CareLinks.To("sugar", PatientUserId);

    protected override async Task OnParametersSetAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        scope = await Access.ResolveAsync(state.User, PatientUserId);
        if (scope.PatientId is not string patientId) return;
        if (Id is int id)
        {
            model = await Records.GetSugarByIdAsync(id, patientId);
        }
        model ??= new SugarReading { UserId = patientId, RecordedAt = DateTime.Now, Value = 100, Kind = SugarKind.Fasting };
    }

    private async Task Save()
    {
        if (model is null || scope?.PatientId is null) return;
        model.UserId = scope.PatientId;
        await Records.SaveSugarAsync(model);
        Nav.NavigateTo(Back);
    }

    private async Task Delete()
    {
        if (Id is int id && scope?.PatientId is not null)
        {
            await Records.DeleteSugarAsync(id, scope.PatientId);
        }
        Nav.NavigateTo(Back);
    }
}
