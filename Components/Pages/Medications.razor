@page "/medications"
@attribute [Authorize]
@inject HealthRecordService Records
@inject PatientAccessService Access
@inject PrescriptionMailService Pharmacy
@inject AuthenticationStateProvider Auth

<PageTitle>Medications</PageTitle>
<RequirePatient Scope="scope" />

@if (scope?.Patient is not null)
{
    <PatientBanner Scope="scope" />
    <div class="page-head accent-meds">
        <div>
            <p class="eyebrow">Treatment</p>
            <h1>Medications</h1>
            <p class="muted">Set the days and the time of day for each dose so reminders call when the medicine is due. Medications in gray were prescribed by a doctor.</p>
        </div>
        @if (scope.Allows(ChartSection.Medication, update: true))
        {
            <a class="btn btn-success" href="@Link("medications/edit")">Add medication</a>
        }
    </div>

    <div class="table-card">
        <table class="table align-middle">
            <thead>
                <tr>
                    @if (CanSend)
                    {
                        <th>Send</th>
                    }
                    <th aria-sort="@AriaSort(MedSort.Medication)">
                        <button type="button" class="sort-th-btn" @onclick="() => SortBy(MedSort.Medication)">
                            Medication <span class="sort-indicator" aria-hidden="true">@SortMark(MedSort.Medication)</span>
                        </button>
                    </th>
                    <th>Dosage</th>
                    <th>Frequency</th>
                    <th aria-sort="@AriaSort(MedSort.Status)">
                        <button type="button" class="sort-th-btn" @onclick="() => SortBy(MedSort.Status)">
                            Status <span class="sort-indicator" aria-hidden="true">@SortMark(MedSort.Status)</span>
                        </button>
                    </th>
                    <th></th>
                </tr>
                <tr class="column-filter-row" @key="_filterVersion">
                    @if (CanSend)
                    {
                        <th></th>
                    }
                    <th>
                        <label class="column-filter-select">
                            <span class="visually-hidden">Filter by medication name</span>
                            <input type="search"
                                   class="form-control form-control-sm"
                                   placeholder="Search name"
                                   value="@_nameFilter"
                                   @oninput="OnNameFilterInput" />
                        </label>
                    </th>
                    <th></th>
                    <th></th>
                    <th>
                        <label class="column-filter-select">
                            <span class="visually-hidden">Filter by status</span>
                            <select class="form-select form-select-sm"
                                    value="@_statusFilter"
                                    @onchange="OnStatusFilterChanged">
                                <option value="">All statuses</option>
                                @foreach (var status in StatusOptions)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </label>
                    </th>
                    <th>
                        @if (HasFilters)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear</button>
                        }
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in VisibleItems)
                {
                    <tr class="@(DoctorPrescribed(item) ? "med-prescribed" : null)">
                        @if (CanSend)
                        {
                            <td data-label="Send">
                                <input type="checkbox"
                                       aria-label="@($"Include {item.Name} in the pharmacy prescription")"
                                       checked="@_picked.Contains(item.Id)"
                                       @onchange="e => TogglePick(item.Id, e)" />
                            </td>
                        }
                        <td data-label="Medication">
                            <strong>@item.Name</strong>
                            @if (DoctorPrescribed(item))
                            {
                                <span class="med-prescribed-tag">Prescribed</span>
                            }
                            <div class="muted">@item.Notes</div>
                            @if (_history.TryGetValue(item.Id, out var events) && events.Count > 0)
                            {
                                <ul class="med-history">
                                    @foreach (var change in events)
                                    {
                                        <li><time datetime="@change.ChangedAt.ToString("o")">@When(change.ChangedAt)</time> @change.ActorName — @change.Summary</li>
                                    }
                                </ul>
                            }
                        </td>
                        <td data-label="Dosage">@item.Dosage</td>
                        <td data-label="Frequency">
                            @item.Frequency
                            @{
                                var schedule = MedicationDayRules.FormatSchedule(item.Days, item.Schedules);
                            }
                            @if (!string.IsNullOrWhiteSpace(schedule))
                            {
                                <div class="muted">@schedule</div>
                            }
                        </td>
                        <td data-label="Status">
                            <StatusPill Label="@(item.IsActive ? "Active" : "Stopped")" CssClass="@(item.IsActive ? "status-ok" : "status-muted")" />
                        </td>
                        <td class="text-end">
                            @if (scope.Allows(ChartSection.Medication, update: true))
                            {
                                <a class="btn btn-sm btn-outline-success" href="@Link($"medications/edit/{item.Id}")">Update</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (items.Count == 0)
        {
            <p class="muted p-3">No medications recorded.</p>
        }
        else if (VisibleItems.Count == 0)
        {
            <p class="muted p-3">No medications match the current filters.</p>
        }
        @if (CanSend && items.Count > 0)
        {
            <div class="med-pharmacy">
                <h2>Send to pharmacist</h2>
                <p class="muted">Enter the pharmacy email. Checked medications are included. If none are checked, every current medication is sent, with the doctor and patient details and a copy to you.</p>
                <label class="form-label" for="pharmacist-email">Pharmacist email</label>
                <input id="pharmacist-email" type="email" class="form-control" autocomplete="email" @bind="_pharmacistEmail" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(_sendMessage))
                {
                    <div class="alert @(_sendOk ? "alert-success" : "alert-danger") py-2 mt-3" role="status">@_sendMessage</div>
                }
                <button type="button" class="btn btn-success mt-3" disabled="@_sending" @onclick="SendToPharmacistAsync">Send to Pharmacist</button>
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? PatientUserId { get; set; }
    private PatientScope? scope;
    private List<Medication> items = [];
    private Dictionary<int, List<MedicationChange>> _history = [];
    private readonly HashSet<int> _picked = [];
    private string _pharmacistEmail = "";
    private string? _sendMessage;
    private bool _sendOk;
    private bool _sending;
    private MedSort _sort = MedSort.Medication;
    private bool _sortAsc = true;

    private string _nameFilter = "";
    private string _statusFilter = "";

    private int _filterVersion;
    private int _appliedFilterVersion;

    private static readonly string[] StatusOptions = ["Active", "Stopped"];

    private enum MedSort
    {
        Medication,
        Status
    }

    private bool CanSend => scope is not null && !scope.IsDoctor && scope.PatientId is not null;

    private static bool DoctorPrescribed(Medication item) =>
        !string.IsNullOrWhiteSpace(item.PrescribingDoctorUserId);

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(_nameFilter)
        || !string.IsNullOrEmpty(_statusFilter);

    private List<Medication> VisibleItems => Sort(Filter(items)).ToList();

    private IEnumerable<Medication> Filter(IEnumerable<Medication> source)
    {
        var query = source;
        if (!string.IsNullOrWhiteSpace(_nameFilter))
        {
            var term = _nameFilter.Trim();
            query = query.Where(x =>
                x.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrWhiteSpace(x.Notes)
                    && x.Notes.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrEmpty(_statusFilter))
        {
            var wantActive = _statusFilter == "Active";
            query = query.Where(x => x.IsActive == wantActive);
        }

        return query;
    }

    private IEnumerable<Medication> Sort(IEnumerable<Medication> source) => _sort switch
    {
        MedSort.Status => _sortAsc
            ? source.OrderBy(StatusRank).ThenBy(x => x.Name)
            : source.OrderByDescending(StatusRank).ThenBy(x => x.Name),
        _ => _sortAsc
            ? source.OrderBy(x => x.Name)
            : source.OrderByDescending(x => x.Name)
    };

    private void SortBy(MedSort column)
    {
        if (_sort == column)
        {
            _sortAsc = !_sortAsc;
            return;
        }

        _sort = column;
        _sortAsc = true;
    }

    private void ClearFilters()
    {
        _nameFilter = "";
        _statusFilter = "";
        _filterVersion++;
    }

    private void OnNameFilterInput(ChangeEventArgs e)
    {
        if (_filterVersion != _appliedFilterVersion) return;
        _nameFilter = e.Value?.ToString() ?? "";
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        if (_filterVersion != _appliedFilterVersion) return;
        _statusFilter = e.Value?.ToString() ?? "";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _appliedFilterVersion = _filterVersion;
    }

    private string AriaSort(MedSort column) =>
        _sort != column ? "none" : _sortAsc ? "ascending" : "descending";

    private string SortMark(MedSort column)
    {
        if (_sort != column)
        {
            return "↕";
        }

        return _sortAsc ? "↑" : "↓";
    }

    private static int StatusRank(Medication item) => item.IsActive ? 0 : 1;

    protected override async Task OnParametersSetAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        scope = (await Access.ResolveAsync(state.User, PatientUserId)).ForSection(ChartSection.Medication, update: false);
        if (scope.PatientId is string id)
        {
            items = await Records.GetMedicationsAsync(id);
            var changes = await Records.GetMedicationChangesAsync(id);
            _history = changes
                .GroupBy(change => change.MedicationId)
                .ToDictionary(group => group.Key, group => group.ToList());
        }
    }

    private void TogglePick(int id, ChangeEventArgs e)
    {
        if (e.Value is bool on && on)
            _picked.Add(id);
        else
            _picked.Remove(id);
    }

    private async Task SendToPharmacistAsync()
    {
        if (!CanSend || scope?.PatientId is null || scope.IsDoctor)
            return;

        _sending = true;
        _sendMessage = null;
        try
        {
            var result = await Pharmacy.SendToPharmacistAsync(scope.CurrentUser.Id, _pharmacistEmail, _picked.ToArray());
            _sendOk = result.Sent;
            _sendMessage = result.Message;
        }
        catch (Exception)
        {
            _sendOk = false;
            _sendMessage = "The prescription could not be sent. Nothing was delivered.";
        }
        finally
        {
            _sending = false;
        }
    }

    private static string When(DateTime value)
    {
        var utc = value.Kind switch
        {
            DateTimeKind.Local => value.ToUniversalTime(),
            DateTimeKind.Utc => value,
            _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
        };
        return utc.ToLocalTime().ToString("MMM d, yyyy h:mm tt");
    }

    private string Link(string path) => CareLinks.To(path, PatientUserId);
}
