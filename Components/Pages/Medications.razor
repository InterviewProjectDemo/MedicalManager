@page "/medications"
@attribute [Authorize]
@inject HealthRecordService Records
@inject PatientAccessService Access
@inject AuthenticationStateProvider Auth

<PageTitle>Medications</PageTitle>
<RequirePatient Scope="scope" />

@if (scope?.Patient is not null)
{
    <PatientBanner Scope="scope" />
    <div class="page-head accent-meds">
        <div>
            <p class="eyebrow">Treatment</p>
            <h1>Medications</h1>
            <p class="muted">Keep dosage, frequency, and notes current so the dashboard stays accurate.</p>
        </div>
        <a class="btn btn-success" href="@Link("medications/edit")">Add medication</a>
    </div>

    <div class="table-card">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th aria-sort="@AriaSort(MedSort.Medication)">
                        <button type="button" class="sort-th-btn" @onclick="() => SortBy(MedSort.Medication)">
                            Medication <span class="sort-indicator" aria-hidden="true">@SortMark(MedSort.Medication)</span>
                        </button>
                    </th>
                    <th>Dosage</th>
                    <th>Frequency</th>
                    <th aria-sort="@AriaSort(MedSort.Status)">
                        <button type="button" class="sort-th-btn" @onclick="() => SortBy(MedSort.Status)">
                            Status <span class="sort-indicator" aria-hidden="true">@SortMark(MedSort.Status)</span>
                        </button>
                    </th>
                    <th></th>
                </tr>
                <tr class="column-filter-row" @key="_filterVersion">
                    <th>
                        <label class="column-filter-select">
                            <span class="visually-hidden">Filter by medication name</span>
                            <input type="search"
                                   class="form-control form-control-sm"
                                   placeholder="Search name"
                                   value="@_nameFilter"
                                   @oninput="OnNameFilterInput" />
                        </label>
                    </th>
                    <th></th>
                    <th></th>
                    <th>
                        <label class="column-filter-select">
                            <span class="visually-hidden">Filter by status</span>
                            <select class="form-select form-select-sm"
                                    value="@_statusFilter"
                                    @onchange="OnStatusFilterChanged">
                                <option value="">All statuses</option>
                                @foreach (var status in StatusOptions)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </label>
                    </th>
                    <th>
                        @if (HasFilters)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear</button>
                        }
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in VisibleItems)
                {
                    <tr>
                        <td>
                            <strong>@item.Name</strong>
                            <div class="muted">@item.Notes</div>
                        </td>
                        <td>@item.Dosage</td>
                        <td>@item.Frequency</td>
                        <td>
                            <StatusPill Label="@(item.IsActive ? "Active" : "Stopped")" CssClass="@(item.IsActive ? "status-ok" : "status-muted")" />
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-success" href="@Link($"medications/edit/{item.Id}")">Update</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (items.Count == 0)
        {
            <p class="muted p-3">No medications recorded.</p>
        }
        else if (VisibleItems.Count == 0)
        {
            <p class="muted p-3">No medications match the current filters.</p>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? PatientUserId { get; set; }
    private PatientScope? scope;
    private List<Medication> items = [];
    private MedSort _sort = MedSort.Medication;
    private bool _sortAsc = true;

    private string _nameFilter = "";
    private string _statusFilter = "";

    private int _filterVersion;
    private int _appliedFilterVersion;

    private static readonly string[] StatusOptions = ["Active", "Stopped"];

    private enum MedSort
    {
        Medication,
        Status
    }

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(_nameFilter)
        || !string.IsNullOrEmpty(_statusFilter);

    private List<Medication> VisibleItems => Sort(Filter(items)).ToList();

    private IEnumerable<Medication> Filter(IEnumerable<Medication> source)
    {
        var query = source;
        if (!string.IsNullOrWhiteSpace(_nameFilter))
        {
            var term = _nameFilter.Trim();
            query = query.Where(x =>
                x.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrWhiteSpace(x.Notes)
                    && x.Notes.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrEmpty(_statusFilter))
        {
            var wantActive = _statusFilter == "Active";
            query = query.Where(x => x.IsActive == wantActive);
        }

        return query;
    }

    private IEnumerable<Medication> Sort(IEnumerable<Medication> source) => _sort switch
    {
        MedSort.Status => _sortAsc
            ? source.OrderBy(StatusRank).ThenBy(x => x.Name)
            : source.OrderByDescending(StatusRank).ThenBy(x => x.Name),
        _ => _sortAsc
            ? source.OrderBy(x => x.Name)
            : source.OrderByDescending(x => x.Name)
    };

    private void SortBy(MedSort column)
    {
        if (_sort == column)
        {
            _sortAsc = !_sortAsc;
            return;
        }

        _sort = column;
        _sortAsc = true;
    }

    private void ClearFilters()
    {
        _nameFilter = "";
        _statusFilter = "";
        _filterVersion++;
    }

    private void OnNameFilterInput(ChangeEventArgs e)
    {
        if (_filterVersion != _appliedFilterVersion) return;
        _nameFilter = e.Value?.ToString() ?? "";
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        if (_filterVersion != _appliedFilterVersion) return;
        _statusFilter = e.Value?.ToString() ?? "";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _appliedFilterVersion = _filterVersion;
    }

    private string AriaSort(MedSort column) =>
        _sort != column ? "none" : _sortAsc ? "ascending" : "descending";

    private string SortMark(MedSort column)
    {
        if (_sort != column)
        {
            return "↕";
        }

        return _sortAsc ? "↑" : "↓";
    }

    private static int StatusRank(Medication item) => item.IsActive ? 0 : 1;

    protected override async Task OnParametersSetAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        scope = await Access.ResolveAsync(state.User, PatientUserId);
        if (scope.PatientId is string id)
        {
            items = await Records.GetMedicationsAsync(id);
        }
    }

    private string Link(string path) => CareLinks.To(path, PatientUserId);
}
