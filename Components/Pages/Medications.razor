@page "/medications"
@attribute [Authorize]
@inject HealthRecordService Records
@inject PatientAccessService Access
@inject AuthenticationStateProvider Auth

<PageTitle>Medications</PageTitle>
<RequirePatient Scope="scope" />

@if (scope?.Patient is not null)
{
    <PatientBanner Scope="scope" />
    <div class="page-head accent-meds">
        <div>
            <p class="eyebrow">Treatment</p>
            <h1>Medications</h1>
            <p class="muted">Keep dosage, frequency, and notes current so the dashboard stays accurate.</p>
        </div>
        <a class="btn btn-success" href="@Link("medications/edit")">Add medication</a>
    </div>

    <div class="table-card">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Medication</th>
                    <th>Dosage</th>
                    <th>Frequency</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>
                            <strong>@item.Name</strong>
                            <div class="muted">@item.Notes</div>
                        </td>
                        <td>@item.Dosage</td>
                        <td>@item.Frequency</td>
                        <td>
                            <StatusPill Label="@(item.IsActive ? "Active" : "Stopped")" CssClass="@(item.IsActive ? "status-ok" : "status-muted")" />
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-success" href="@Link($"medications/edit/{item.Id}")">Update</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (items.Count == 0)
        {
            <p class="muted p-3">No medications recorded.</p>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? PatientUserId { get; set; }
    private PatientScope? scope;
    private List<Medication> items = [];

    protected override async Task OnParametersSetAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        scope = await Access.ResolveAsync(state.User, PatientUserId);
        if (scope.PatientId is string id)
        {
            items = await Records.GetMedicationsAsync(id);
        }
    }

    private string Link(string path) => CareLinks.To(path, PatientUserId);
}
