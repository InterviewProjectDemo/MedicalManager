@page "/"
@page "/chart-board"
@attribute [AllowAnonymous]
@implements IDisposable
@inject DashboardLayoutService Layouts
@inject AuthenticationStateProvider Auth
@inject PatientAccessService Access
@inject NavigationManager Navigation
@inject UserManager<ApplicationUser> Users
@using MedicalManager.Data.Notifications

<PageTitle>@(StudioHome ? "Home" : "Dashboard")</PageTitle>

@if (!_ready)
{
    <p>Loading...</p>
}
else if (StudioHome)
{
    <PictorialHome SignedIn="_signedIn" PatientUserId="@PatientUserId" Hello="@_hello" />
}
else if (!_signedIn)
{
    <div class="page-head">
        <div>
            <p class="eyebrow">Medical Manager</p>
            <h1>Medical Manager</h1>
            <p class="muted">A live personal health record from @SmsCopy.BusinessName.</p>
        </div>
    </div>
    <article class="legal-page">
        <p>
            Medical Manager is live at <a href="@SmsCopy.HomeUrl">www.medicalmgr.com</a>.
            Support: <a href="mailto:@SmsCopy.SupportEmail">@SmsCopy.SupportEmail</a>.
        </p>
        <p>
            Patients track blood pressure, blood sugar, labs, medications, appointments, and to-dos.
            A doctor opens a chart only after the patient approves that request with a code sent to the patient's own phone.
        </p>
        <p><a class="btn btn-purple" href="Account/Login">Log in</a> <a class="btn btn-outline-secondary" href="Account/Register">Register</a></p>
    </article>
}
else if (layout is null)
{
    <p>Loading dashboard...</p>
}
else
{
    <DashboardLiveView PatientUserId="@PatientUserId" Layout="layout" />
}

@code {
    [SupplyParameterFromQuery]
    public string? PatientUserId { get; set; }

    private DashboardLayout? layout;
    private bool _signedIn;
    private bool _ready;
    private bool _onboardingChecked;
    private string _hello = "there";

    private bool StudioHome => StudioLayout.Enabled && !IsChartBoard;

    private bool IsChartBoard =>
        Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/')
            .Equals("chart-board", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await LoadAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _signedIn = state.User.Identity?.IsAuthenticated == true;
        if (!_signedIn)
        {
            _ready = true;
            return;
        }

        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var account = string.IsNullOrEmpty(userId) ? null : await Users.FindByIdAsync(userId);
        _hello = GivenName(account?.FullName);
        if (!_onboardingChecked)
        {
            _onboardingChecked = true;
            if (await Access.NeedsOnboardingAsync(state.User))
            {
                Navigation.NavigateTo("/onboarding");
                return;
            }
        }

        if (!StudioHome)
            layout = await Layouts.GetForUserAsync(userId ?? "");

        _ready = true;
    }

    private static string GivenName(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "there";

        var first = NameSpeaker.Split(fullName).First;
        return string.IsNullOrWhiteSpace(first) ? "there" : first;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
