@page "/"
@attribute [Authorize]
@inject DashboardLayoutService Layouts
@inject AuthenticationStateProvider Auth
@inject PatientAccessService Access
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

@if (layout is null)
{
    <p>Loading dashboard...</p>
}
else
{
    <DashboardLiveView PatientUserId="@PatientUserId" Layout="layout" />
}

@code {
    [SupplyParameterFromQuery]
    public string? PatientUserId { get; set; }

    private DashboardLayout? layout;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        if (await Access.NeedsOnboardingAsync(state.User))
        {
            Navigation.NavigateTo("/onboarding");
            return;
        }

        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        layout = await Layouts.GetForUserAsync(userId ?? "");
    }
}
