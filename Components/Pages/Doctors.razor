@page "/doctors"
@attribute [Authorize]
@inject DoctorService DoctorRecords
@inject PatientAccessService Access
@inject AuthenticationStateProvider Auth

<PageTitle>Doctors</PageTitle>
<RequirePatient Scope="scope" />

@if (scope?.Patient is not null)
{
    <PatientBanner Scope="scope" />
    <div class="page-head accent-providers">
        <div>
            <p class="eyebrow">Care team</p>
            <h1>Doctors</h1>
            <p class="muted">Your providers from appointments and medications appear here automatically. Add or update contact details anytime.</p>
        </div>
        <a class="btn btn-teal" href="@Link("doctors/edit")">Add doctor</a>
    </div>

    <div class="table-card">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Specialty</th>
                    <th>Phone</th>
                    <th>Source</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@(string.IsNullOrWhiteSpace(item.Specialty) ? "—" : item.Specialty)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "—" : item.PhoneNumber)</td>
                        <td><StatusPill Label="@SourceLabel(item)" CssClass="@SourceCss(item)" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-teal" href="@Link($"doctors/edit/{item.Id}")">Update</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (items.Count == 0)
        {
            <p class="muted p-3">No doctors yet. Add one manually or enter provider names on appointments and medications.</p>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? PatientUserId { get; set; }
    private PatientScope? scope;
    private List<Doctor> items = [];

    protected override async Task OnParametersSetAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        scope = await Access.ResolveAsync(state.User, PatientUserId);
        if (scope.PatientId is string id)
        {
            items = await DoctorRecords.GetDoctorsAsync(id);
        }
    }

    private string Link(string path) => CareLinks.To(path, PatientUserId);

    private static string SourceLabel(Doctor doctor) => doctor.Source switch
    {
        DoctorSource.Manual => "Manual",
        DoctorSource.FromAppointment => "From appointment",
        DoctorSource.FromMedication => "From medication",
        _ => doctor.Source.ToString()
    };

    private static string SourceCss(Doctor doctor) => doctor.Source switch
    {
        DoctorSource.Manual => "status-ok",
        DoctorSource.FromAppointment => "status-warn",
        DoctorSource.FromMedication => "status-muted",
        _ => "status-muted"
    };
}
