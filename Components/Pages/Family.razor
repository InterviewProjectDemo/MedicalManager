@page "/family"
@attribute [Authorize]
@inject NavigationManager NavigationManager

<PageTitle>Family</PageTitle>

<div class="page-head accent-family">
    <div>
        <p class="eyebrow">Easy to reach</p>
        <h1>Family</h1>
        <p class="muted">Drag the Family button out of the left menu, place it where it is easy to see, and resize it until it is comfortable to press.</p>
    </div>
</div>

<section class="family-page">
    <p>The button stays on top of the dashboard. You can still use every other control around it. Choose Menu on the button to put it back in the side menu.</p>
    <a class="btn family-home-btn" href="@Href("")">Back to dashboard</a>
</section>

@code {
    private string? selectedPatientId;

    protected override void OnInitialized()
    {
        UpdateFromUri();
    }

    private void UpdateFromUri()
    {
        selectedPatientId = null;
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue("patientUserId", out var value))
        {
            selectedPatientId = value.ToString();
        }
    }

    private string Href(string path) => CareLinks.To(path, selectedPatientId);
}
