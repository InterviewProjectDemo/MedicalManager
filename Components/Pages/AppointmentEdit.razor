@page "/appointments/edit"
@page "/appointments/edit/{Id:int}"
@attribute [Authorize]
@inject HealthRecordService Records
@inject PatientAccessService Access
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Add" : "Update") appointment</PageTitle>
<RequirePatient Scope="scope" />

@if (model is not null)
{
    <PatientBanner Scope="scope" />
    <div class="page-head accent-appt">
        <div>
            <p class="eyebrow">Appointments</p>
            <h1>@(Id is null ? "Add appointment" : "Update appointment")</h1>
        </div>
    </div>

    <EditForm Model="model" OnValidSubmit="Save" class="form-card">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Title</label>
                <InputText class="form-control" @bind-Value="model.Title" />
            </div>
            <div class="col-md-6">
                <label class="form-label">With whom</label>
                <InputText class="form-control" @bind-Value="model.ProviderName" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Location</label>
                <InputText class="form-control" @bind-Value="model.Location" placeholder="Clinic name and street address" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Purpose</label>
                <InputText class="form-control" @bind-Value="model.Purpose" placeholder="Follow-up, lab work, annual exam" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <InputSelect class="form-select" @bind-Value="model.Status">
                    @foreach (var status in Enum.GetValues<AppointmentStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-6">
                <label class="form-label">Starts</label>
                <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="model.StartsAt" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Ends</label>
                <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="model.EndsAt" />
            </div>
            <div class="col-12">
                <label class="form-label">Notes</label>
                <InputTextArea class="form-control" @bind-Value="model.Notes" />
            </div>
        </div>
        <p class="muted mt-3 mb-0">
            One day before this visit, Medical Manager calls and texts the phone number on the patient profile.
            One hour before, it calls again. The call says the patient's full name, the time, the purpose, and where to go.
            A home address on the profile lets the reminder include drive time.
        </p>
        <div class="form-actions">
            <button type="submit" class="btn btn-purple">Save</button>
            <a class="btn btn-outline-secondary" href="@Back">Cancel</a>
            @if (Id is not null)
            {
                <button type="button" class="btn btn-outline-danger ms-auto" @onclick="Delete">Delete</button>
            }
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] public string? PatientUserId { get; set; }
    private PatientScope? scope;
    private Appointment? model;
    private string Back => CareLinks.To("appointments", PatientUserId);

    protected override async Task OnParametersSetAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        scope = await Access.ResolveAsync(state.User, PatientUserId);
        if (scope.PatientId is not string patientId) return;
        if (Id is int id)
        {
            model = await Records.GetAppointmentByIdAsync(id, patientId);
        }
        model ??= new Appointment
        {
            UserId = patientId,
            StartsAt = DateTime.Now.AddDays(1).Date.AddHours(9),
            EndsAt = DateTime.Now.AddDays(1).Date.AddHours(9).AddMinutes(30)
        };
    }

    private async Task Save()
    {
        if (model is null || scope?.PatientId is null) return;
        model.UserId = scope.PatientId;
        if (model.EndsAt is null)
        {
            model.EndsAt = model.StartsAt.AddMinutes(30);
        }
        await Records.SaveAppointmentAsync(model);
        Nav.NavigateTo(Back);
    }

    private async Task Delete()
    {
        if (Id is int id && scope?.PatientId is not null)
        {
            await Records.DeleteAppointmentAsync(id, scope.PatientId);
        }
        Nav.NavigateTo(Back);
    }
}
