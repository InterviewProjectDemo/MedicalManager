@page "/patients"
@attribute [Authorize(Roles = "Doctor")]
@rendermode InteractiveServer
@inject PatientAccessService Access
@inject ChartAccessService ChartAccess
@inject ProfilePhotoService Photos
@inject AuthenticationStateProvider Auth
@inject GrantedPatientSelection Selection

<PageTitle>Patients</PageTitle>

<div class="page-head accent-doctor">
    <div class="identity-row">
        <PersonPhoto Url="@_doctorPhotoUrl" Size="lg" Alt="" />
        <div>
            <p class="eyebrow">Doctor workspace</p>
            <h1>Patients</h1>
            <p class="muted">Choose a patient you are affiliated with, then check View, Update, or both for each record. The patient approves with a code sent to the phone on their account, and to their email when one is saved. You never see that code.</p>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(status))
{
    <div class="alert @(statusOk ? "alert-success" : "alert-danger")" role="status">@status</div>
}

@if (pending.Count > 0)
{
    <div class="table-card mb-3">
        <h2 class="h5 px-3 pt-3">Waiting for patient approval</h2>
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Requested</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in pending)
                {
                    <tr>
                        <td data-label="Patient">
                            <strong>@row.RequestedName</strong>
                            <div class="muted">@row.DateOfBirth?.ToString("MMMM d, yyyy")</div>
                        </td>
                        <td data-label="Requested">@ChartAccessText.Describe(row.Lab, row.BloodPressure, row.Sugar, row.Medication, row.ToDo, row.Doctors)</td>
                        <td class="text-end">
                            @if (!string.IsNullOrWhiteSpace(row.TextNotSentReason))
                            {
                                <span class="muted">@row.TextNotSentReason</span>
                            }
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Resend(row.Id)">Send a new code</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="table-card">
    <h2 class="h5 px-3 pt-3">Affiliated patients</h2>
    @if (!_ready)
    {
        <p class="muted p-3 mb-0">Loading patients...</p>
    }
    else if (affiliated.Count == 0)
    {
        <p class="muted p-3 mb-0">No affiliated patients yet. A patient shows up here after they list you as their doctor, a prescription or appointment uses your name, or you already have an access request with them.</p>
    }
    else
    {
        <table class="table align-middle patient-pick-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Patient</th>
                    <th>Date of birth</th>
                    <th>Access</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in affiliated)
                {
                    var selected = row.PatientId == _selectedPatientId;
                    <tr class="patient-pick @(selected ? "is-selected" : null)" @onclick="() => Pick(row)">
                        <td>
                            <input type="radio"
                                   name="affiliated-patient"
                                   checked="@selected"
                                   aria-label="@($"Select {row.PatientName}")"
                                   @onchange="() => Pick(row)" />
                        </td>
                        <td data-label="Patient">
                            <span class="identity-row">
                                <PersonPhoto Url="@PhotoUrl(row)" Size="sm" Alt="" />
                                <strong>@row.PatientName</strong>
                            </span>
                        </td>
                        <td data-label="Date of birth">@(row.DateOfBirth?.ToString("MMMM d, yyyy") ?? "Not on profile")</td>
                        <td data-label="Access">@AccessStatus(row)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (SelectedPatient is AffiliatedPatientItem chosen)
{
    <div class="table-card access-request-card">
        <h2 class="h5">Request access for @chosen.PatientName</h2>
        @if (chosen.DateOfBirth is DateOnly dob)
        {
            <p class="muted">Date of birth on the profile: @dob.ToString("MMMM d, yyyy")</p>
        }
        else
        {
            <p class="muted">Date of birth is not on this profile yet. The request still goes to this account.</p>
        }
        @if (SelectedGrant is DoctorGrantItem grant)
        {
            <p>Approved now: @ChartAccessText.Describe(grant.Lab, grant.BloodPressure, grant.Sugar, grant.Medication, grant.ToDo, grant.Doctors)</p>
            <div class="d-flex gap-2 flex-wrap mb-3">
                @if (grant.BloodPressure != ChartAccessLevel.None || grant.Sugar != ChartAccessLevel.None || grant.Medication != ChartAccessLevel.None)
                {
                    <a class="btn btn-sm btn-primary" href="@CareLinks.To("", grant.PatientId)">Dashboard</a>
                }
                @if (grant.BloodPressure != ChartAccessLevel.None)
                {
                    <a class="btn btn-sm btn-outline-primary" href="@CareLinks.To("blood-pressure", grant.PatientId)">Blood pressure</a>
                }
                @if (grant.Sugar != ChartAccessLevel.None)
                {
                    <a class="btn btn-sm btn-outline-warning" href="@CareLinks.To("sugar", grant.PatientId)">Sugar</a>
                }
                @if (grant.Lab != ChartAccessLevel.None)
                {
                    <a class="btn btn-sm btn-outline-success" href="@CareLinks.To("labs", grant.PatientId)">Labs</a>
                }
                @if (grant.Medication != ChartAccessLevel.None)
                {
                    <a class="btn btn-sm btn-outline-success" href="@CareLinks.To("medications", grant.PatientId)">Medication</a>
                }
                @if (grant.ToDo != ChartAccessLevel.None)
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@CareLinks.To("todos", grant.PatientId)">To Do</a>
                }
                @if (grant.Doctors != ChartAccessLevel.None)
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@CareLinks.To("doctors", grant.PatientId)">Doctors</a>
                }
            </div>
        }
        <fieldset class="access-scope">
            <legend>Records to request</legend>
            <p class="muted">Check View, Update, or both. Update includes viewing that record.</p>
            <ScopeRow Title="Labs" @bind-Selected="labOn" @bind-Level="labLevel" />
            <ScopeRow Title="Blood pressure chart and list" @bind-Selected="bpOn" @bind-Level="bpLevel" />
            <ScopeRow Title="Sugar chart and list" @bind-Selected="sugarOn" @bind-Level="sugarLevel" />
            <ScopeRow Title="Medication chart and list" @bind-Selected="medicationOn" @bind-Level="medicationLevel" />
            <ScopeRow Title="To Do" @bind-Selected="todoOn" @bind-Level="todoLevel" />
            <ScopeRow Title="Doctors" @bind-Selected="doctorsOn" @bind-Level="doctorsLevel" />
        </fieldset>
        <p class="muted">You do not choose the phone number or the email. The code goes to the number the patient already saved, and to their account email when one is saved.</p>
        <button type="button" class="btn btn-primary" @onclick="Submit" disabled="@busy">Send approval request</button>
    </div>
}

@if (SelectedGrant is not null)
{
    <DoctorChartPanel PatientUserId="@_selectedPatientId" PatientName="@_selectedPatientName" />
}

@code {
    private List<AffiliatedPatientItem> affiliated = [];
    private List<DoctorGrantItem> grants = [];
    private List<DoctorAccessRequestItem> pending = [];
    private string? status;
    private bool statusOk;
    private bool busy;
    private bool _ready;
    private bool labOn;
    private bool bpOn;
    private bool sugarOn;
    private bool medicationOn;
    private bool todoOn;
    private bool doctorsOn;
    private ChartAccessLevel labLevel = ChartAccessLevel.View;
    private ChartAccessLevel bpLevel = ChartAccessLevel.View;
    private ChartAccessLevel sugarLevel = ChartAccessLevel.View;
    private ChartAccessLevel medicationLevel = ChartAccessLevel.View;
    private ChartAccessLevel todoLevel = ChartAccessLevel.View;
    private ChartAccessLevel doctorsLevel = ChartAccessLevel.View;
    private string? doctorId;
    private string? _doctorPhotoUrl;
    private string? _selectedPatientId;
    private string? _selectedPatientName;

    private AffiliatedPatientItem? SelectedPatient =>
        affiliated.FirstOrDefault(row => row.PatientId == _selectedPatientId);

    private DoctorGrantItem? SelectedGrant =>
        grants.FirstOrDefault(row => row.PatientId == _selectedPatientId);

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        doctorId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrWhiteSpace(doctorId))
            _doctorPhotoUrl = await Photos.GetPhotoUrlForUserAsync(doctorId);
        _selectedPatientId = Selection.PatientUserId;
        _selectedPatientName = Selection.PatientName;
        await Reload();
    }

    private async Task Reload()
    {
        if (string.IsNullOrWhiteSpace(doctorId))
            return;

        affiliated = (await ChartAccess.ListAffiliatedPatientsAsync(doctorId)).ToList();
        grants = (await Access.ListGrantedPatientsAsync(doctorId)).ToList();
        pending = (await ChartAccess.ListRequestsForDoctorAsync(doctorId)).ToList();
        _ready = true;
        if (affiliated.All(row => row.PatientId != _selectedPatientId))
        {
            _selectedPatientId = null;
            _selectedPatientName = null;
            Selection.Select(null, null);
            return;
        }

        if (_selectedPatientId is not null)
            Selection.Select(_selectedPatientId, _selectedPatientName);
    }

    private void Pick(AffiliatedPatientItem row)
    {
        _selectedPatientId = row.PatientId;
        _selectedPatientName = row.PatientName;
        Selection.Select(row.PatientId, row.PatientName);
        status = null;
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(doctorId) || string.IsNullOrWhiteSpace(_selectedPatientId))
            return;

        busy = true;
        var result = await ChartAccess.SubmitForPatientAsync(
            doctorId,
            _selectedPatientId,
            labOn ? labLevel : ChartAccessLevel.None,
            bpOn ? bpLevel : ChartAccessLevel.None,
            sugarOn ? sugarLevel : ChartAccessLevel.None,
            medicationOn ? medicationLevel : ChartAccessLevel.None,
            todoOn ? todoLevel : ChartAccessLevel.None,
            doctorsOn ? doctorsLevel : ChartAccessLevel.None);
        status = result.Message;
        statusOk = result.Accepted && result.CodeSent;
        busy = false;
        if (result.Accepted)
        {
            labOn = bpOn = sugarOn = medicationOn = todoOn = doctorsOn = false;
            await Reload();
        }
    }

    private string? PhotoUrl(AffiliatedPatientItem row) => Photos.GetPhotoUrl(row.PatientId, row.PhotoUpdatedAt);

    private static string AccessStatus(AffiliatedPatientItem row)
    {
        if (row.HasGrant && row.RequestPending)
            return "Access approved, new request waiting";
        if (row.HasGrant)
            return "Access approved";
        if (row.RequestPending)
            return "Waiting for approval";
        return "No access yet";
    }

    private async Task Resend(int requestId)
    {
        if (string.IsNullOrWhiteSpace(doctorId))
            return;

        var result = await ChartAccess.ResendAsync(doctorId, requestId);
        status = result.Message;
        statusOk = result.Accepted && result.CodeSent;
        await Reload();
    }
}
