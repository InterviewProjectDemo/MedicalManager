## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# User-specific
*.user
*.suo
*.userosscache
*.sln.docstates

# VS / Rider / VS Code
.vs/
.idea/
.vscode/

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Local SQLite (recreated on startup)
*.db
*.db-shm
*.db-wal

# Logs
*.log
logs/

# OS
Thumbs.db
Desktop.ini
.DS_Store
