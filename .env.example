POSTGRES_USER=medical
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=medicalmanager
MEDICALMANAGER_PHI_KEY=replace-with-base64-32-byte-key

# Gmail SMTP for welcome and password-reset emails (medmgr.us@gmail.com).
# Create a Google App Password: Google Account → Security → 2-Step Verification → App passwords.
EMAIL_SMTP_PASSWORD=

# Twilio number that places appointment reminder calls and texts.
# One day before: phone call and text. One hour before: phone call.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
